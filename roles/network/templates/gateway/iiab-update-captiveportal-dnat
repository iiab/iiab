#!/bin/bash

IPTABLES=/sbin/iptables
CHAIN=IIAB_CAPTIVEPORTAL
LOCK_FILE=/run/lock/iiab-captiveportal-dnat.lock

iiab_var_value() {
    v1=$(grep "^$1:\s" /opt/iiab/iiab/vars/default_vars.yml | tail -1 | sed "s/^$1:\s\+//; s/#.*//; s/\s*$//; s/^\(['\"]\)\(.*\)\1$/\2/")
    v2=$(grep "^$1:\s" /etc/iiab/local_vars.yml | tail -1 | sed "s/^$1:\s\+//; s/#.*//; s/\s*$//; s/^\(['\"]\)\(.*\)\1$/\2/")
    [ "$v2" != "" ] && echo "$v2" || echo "$v1"
}

source /etc/iiab/iiab.env
lan=$IIAB_LAN_DEVICE
wan=$IIAB_WAN_DEVICE
lan_ip=$(iiab_var_value lan_ip)
captiveportal_enabled=$(iiab_var_value captiveportal_enabled)

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

# The generator creates this chain and its PREROUTING jump. It may not exist
# during an upgrade until the next firewall regeneration.
$IPTABLES -t nat -F "$CHAIN" 2>/dev/null || exit 0

if [ "$captiveportal_enabled" != "True" ] || [ "$lan" == "none" ]; then
    exit 0
fi

if [ "$wan" == "none" ]; then
    $IPTABLES -t nat -A "$CHAIN" -j DNAT --to "$lan_ip:80"
    exit 0
fi

# Use a fixed Cloudflare endpoint so captive-portal DNS overrides cannot make
# this health check succeed by resolving a probe hostname locally.
if ! curl --ipv4 --interface "$wan" --noproxy '*' \
    --connect-timeout 3 --max-time 5 --silent --output /dev/null \
    --insecure https://1.1.1.1/cdn-cgi/trace; then
    $IPTABLES -t nat -A "$CHAIN" -j DNAT --to "$lan_ip:80"
fi
