[Unit]
Description=Forgejo (Internet-in-a-Box Git service)
After=network.target
{% if forgejo_db_engine == 'mariadb' %}
After=mariadb.service
Wants=mariadb.service
{% endif %}

[Service]
Type=simple
User={{ forgejo_user }}
Group={{ forgejo_user }}
WorkingDirectory={{ forgejo_run_directory }}
; ExecStart uses the stable symlink, so an update (runrole --reinstall forgejo) just
; repoints it to the new binary and restarts, without rewriting this unit.
ExecStart={{ forgejo_link_path }} web --config {{ forgejo_config_path }}
Restart=always
RestartSec=2s
Environment=USER={{ forgejo_user }} HOME={{ forgejo_home }} FORGEJO_WORK_DIR={{ forgejo_run_directory }}

[Install]
WantedBy=multi-user.target
