#!/bin/bash

KIWIXLIB="{{ kiwix_library_path }}"

LOCK_PATH="/run/lock/kiwix"
LOCK_DIR="${LOCK_PATH}/make-kiwix-lib.lockdir"
mkdir -p "$LOCK_PATH"

kiwix_stop() {
    if command -v pdsm >/dev/null 2>&1; then
        pdsm stop kiwix
    else
        systemctl stop kiwix-serve
    fi
}
kiwix_start() {
    if command -v pdsm >/dev/null 2>&1; then
        pdsm restart kiwix
    else
        systemctl start kiwix-serve
    fi
}

# Acquire lockdir (wait up to 5 min; auto-clear if stale >10 min)
start_ts=$(date +%s)
while ! mkdir "$LOCK_DIR" 2>/dev/null; do
  now=$(date +%s)
  lock_mtime=$(stat -c %Y "$LOCK_DIR" 2>/dev/null || echo "$now")
  if (( now - lock_mtime > 600 )); then
    rm -rf "$LOCK_DIR" 2>/dev/null || true
    continue
  fi
  if (( now - start_ts > 300 )); then
    echo "Timeout waiting for lock: $LOCK_DIR" >&2
    exit 1
  fi
  sleep 2
done
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

echo "Now running iiab-make-kiwix-lib.py"
/usr/bin/iiab-make-kiwix-lib.py "$@"
rc=$?
if [ $rc -ne 0 ]; then
  echo "iiab-make-kiwix-lib.py failed (rc=$rc); keeping the previous library" >&2
  exit $rc
fi

# The Python builder replaces the library atomically, so kiwix-serve can keep
# serving while the catalog is rebuilt.  Restart it to load the new file.
if [ -s "$KIWIXLIB" ]; then
  kiwix_stop
  kiwix_start
else
  echo "WARNING: expected library not found or empty: $KIWIXLIB" >&2
  exit 1
fi
echo "Finished making Kiwix library"
exit 0
