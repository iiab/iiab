<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ azuracast_radio_page_title }}</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  body {
    margin: 0 auto;
    padding: 1.25rem;
    max-width: 42rem;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    line-height: 1.5;
  }
  h1 { font-size: 1.6rem; margin: 0 0 .25rem; }
  h2 { font-size: 1.25rem; margin: 0 0 .25rem; }
  .sub { margin: 0 0 1rem; opacity: .75; }
  #health { min-height: 1.5rem; margin: 0 0 1rem; font-weight: 600; }
  #health.ok { color: #1a7f37; }
  #health.bad { color: #b42318; }
  article {
    border: 1px solid #8884;
    border-radius: .75rem;
    padding: 1rem;
    margin: 0 0 1rem;
  }
  audio { width: 100%; margin: .75rem 0; }
  .links { display: flex; gap: 1.25rem; flex-wrap: wrap; font-size: .95rem; }
  .empty { opacity: .75; }
</style>
</head>
<body>

<h1>{{ azuracast_radio_page_title }}</h1>
<p class="sub">{{ azuracast_radio_page_subtitle }}</p>
<p id="health" role="status"></p>

{% for station in azuracast_stations %}
<article>
  <h2>{{ station.name }}</h2>
  {% if station.description | default('') %}
  <p>{{ station.description }}</p>
  {% endif %}
  <audio controls preload="none" src="/radio/listen/{{ station.short_name }}{{ (_ac_station_mounts | default({})).get(station.short_name, azuracast_stream_mount) }}"></audio>
  <div class="links">
    <a href="/radio/{{ station.short_name }}.m3u">Open in a player</a>
    <a href="http://{{ azuracast_public_host }}:{{ azuracast_http_port }}/public/{{ station.short_name }}">Full player</a>
  </div>
</article>
{% else %}
<p class="empty">No channels are configured yet.</p>
{% endfor %}

<script>
(function () {
  var el = document.getElementById('health');
  fetch('/radio/status.json', { cache: 'no-store' })
    .then(function (response) { return response.json(); })
    .then(function (status) {
      el.textContent = (status.ok ? 'Radio is working' : 'Radio needs attention')
        + ' (checked ' + status.checked + ')';
      el.className = status.ok ? 'ok' : 'bad';
    })
    .catch(function () { el.textContent = ''; });
})();
</script>

</body>
</html>
