# Managed by IIAB role "azuracast" -- root-only, mode 0600.
# Read by bootstrap.yml and passed to AzuraCast's CLI as environment variables.
INIT_ADMIN_EMAIL="{{ azuracast_admin_email }}"
INIT_ADMIN_PASSWORD="{{ azuracast_admin_password }}"
INIT_ADMIN_API_KEY="{{ azuracast_api_key }}"
INIT_BASE_URL="http://{{ azuracast_public_host }}:{{ azuracast_http_port }}"
INIT_INSTANCE_NAME="{{ azuracast_instance_name }}"
