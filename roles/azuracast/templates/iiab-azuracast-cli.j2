#!/bin/sh
# Managed by IIAB role "azuracast".
# Run AzuraCast's CLI inside its Docker container, without a TTY.
set -e

cd /opt/azuracast

if docker compose version >/dev/null 2>&1; then
    DC="docker compose"
else
    DC="docker-compose"
fi

exec $DC exec -T --user=azuracast web azuracast_cli "$@"
