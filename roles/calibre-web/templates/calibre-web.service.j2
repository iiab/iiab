[Unit]
Description=Calibre-Web

[Service]
Type=simple
User={{ calibreweb_user }}
Environment=TMPDIR=/library/downloads/calibre-web
# Let nginx send library files via X-Accel-Redirect, so large video/audio
# downloads don't have to be read into Calibre-Web's memory.
# Requires the internal /protected-stream/ location in calibre-web-nginx.conf.j2.
Environment=CALIBRE_X_ACCEL_REDIRECT=1
ExecStartPre=-/usr/bin/mkdir -p /library/downloads/calibre-web
ExecStart={{ calibreweb_venv_path }}/bin/python3 {{ calibreweb_exec_path }} -p {{ calibreweb_config }}/{{ calibreweb_settings_database }}

[Install]
WantedBy=multi-user.target
