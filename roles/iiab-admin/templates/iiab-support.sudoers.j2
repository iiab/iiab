# Installed by IIAB's iiab-admin role.
#
# Grants the Admin Console group only the IIAB support commands listed below.
# It does not grant a shell, an editor, or general root access.  To change the
# list, edit iiab_admin_support_commands in /etc/iiab/local_vars.yml and re-run
# ./runrole iiab-admin.
{% for command in iiab_admin_support_commands -%}
%{{ admin_console_group }} ALL=(root) NOPASSWD: {{ command }}
{% endfor -%}
