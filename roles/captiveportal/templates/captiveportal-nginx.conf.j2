# Captive Portal endpoints served through the normal IIAB NGINX server.
# Installed by roles/captiveportal into nginx conf.d, which server.conf
# includes inside the normal server. This gives the splash a non-HSTS URL on
# the LAN address and canonical names (for example fedoraproject.org is
# HSTS-preloaded). The banner is referenced relative to /captive_splash,
# hence the matching location.
location = /captive_splash {
    include uwsgi_params;
    uwsgi_param HTTP_HOST $http_host;
    uwsgi_param SERVER_NAME $host;
    uwsgi_param HTTP_X_FORWARDED_FOR $remote_addr;
    uwsgi_pass unix:///run/uwsgi/captiveportal.socket;
    error_page 502 503 504 =302 http://{{ iiab_fqdn }}/;
}
location = /iiab_banner6.png {
    include uwsgi_params;
    uwsgi_param HTTP_HOST $http_host;
    uwsgi_param SERVER_NAME $host;
    uwsgi_param HTTP_X_FORWARDED_FOR $remote_addr;
    uwsgi_pass unix:///run/uwsgi/captiveportal.socket;
}
location = /home_selected {
    include uwsgi_params;
    uwsgi_param HTTP_HOST $http_host;
    uwsgi_param SERVER_NAME $host;
    uwsgi_param HTTP_X_FORWARDED_FOR $remote_addr;
    uwsgi_pass unix:///run/uwsgi/captiveportal.socket;
}
