{% for line in lookup('file', role_path + '/templates/checkurls').splitlines() %}
{% set hostname = line | trim %}
{% if hostname and not hostname.startswith('#') %}
{% set domain = hostname | regex_replace('^\\.\\*\\.', '') | regex_replace('^\\*\\.', '') %}
address=/{{ domain }}/{{ captiveportal_probe_ip }}
{% endif %}
{% endfor %}
# Fallback for other hostnames, including OEM probes not in checkurls.
address=/#/{{ lan_ip }}
# Keep loopback names local despite the catch-all.
address=/localhost/127.0.0.1
# RFC 8910 Captive Portal Identification for iOS/macOS.
dhcp-option=114,http://captive.lan/.well-known/captive-portal
# Windows NCSI captive portal detection.
address=/dns.msftncsi.com/131.107.255.255
