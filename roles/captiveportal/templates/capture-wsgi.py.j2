def tstamp(dtime):
    '''return a UNIX style seconds since 1970 for datetime input'''
    epoch = datetime.datetime(1970, 1, 1,tzinfo=tzutc())
    newdtime = dtime.astimezone(tzutc())
    since_epoch_delta = newdtime - epoch
    return since_epoch_delta.total_seconds()

# ########## transient client state ##############
client_states = {}

def new_client_state():
    return {
        "mac": "",
        "current_ts": 0,
        "lasttimestamp": 0,
        "send204after": 0,
        "portal_completed": False,
        "os": "",
        "os_version": "",
        "last_seen": time.monotonic(),
    }

def prune_client_states():
    now = time.monotonic()
    expired = [
        ip for ip, state in client_states.items()
        if now - state["last_seen"] > CLIENT_STATE_TTL
    ]
    for ip in expired:
        del client_states[ip]
    # mac_cache entries past their TTL can never be served again; drop them
    # so MACs do not outlive their usefulness in process memory
    stale = [
        ip for ip, cached in mac_cache.items()
        if now - cached[0] > MAC_CACHE_TTL
    ]
    for ip in stale:
        del mac_cache[ip]

def get_client_state(ip):
    state = client_states.get(ip)
    if state is None:
        state = new_client_state()
        client_states[ip] = state
    return state

mac_cache = {}

def update_client_state(ip, mac, system, system_version):
    state = get_client_state(ip)
    # Reset only on a genuine device change: two known, differing MACs.
    # An empty MAC means the lookup degraded (no neighbor entry yet,
    # timeout) -- "unknown" must not be treated as "changed" or a single
    # transient failure would wipe portal_completed mid-session.
    if mac and state["mac"] and state["mac"] != mac:
        state.update(
            mac=mac,
            os=system,
            os_version=system_version,
            lasttimestamp=0,
            send204after=0,
            portal_completed=False,
        )
    else:
        state.update(os=system, os_version=system_version)
        if mac: # never overwrite a known MAC with an unknown one
            state["mac"] = mac

def get_mac(ip):
    now = time.monotonic()
    cached = mac_cache.get(ip)
    if cached and now - cached[0] < MAC_CACHE_TTL:
        return cached[1]

    # iproute2's `ip neigh` resolves IPv4 and IPv6 neighbors alike (net-tools'
    # `arp` rejects IPv6 addresses with exit 255).  Anything unexpected --
    # unparseable address, timeout, missing binary -- degrades to "no MAC"
    # instead of failing the request.  Failed lookups are not cached, so the
    # next request retries; successful ones (including "no entry") are.
    try:
        output = subprocess.check_output(
            ["ip", "neigh", "show", "to", ip],
            text=True,
            stderr=subprocess.PIPE,
            timeout=NEIGHBOR_LOOKUP_TIMEOUT,
        )
    except subprocess.CalledProcessError as exc:
        logger.debug("neighbor lookup rejected %r: %s", ip, (exc.stderr or "").strip())
        return ""
    except (subprocess.SubprocessError, OSError) as exc:
        logger.warning("neighbor lookup failed for %r: %s", ip, exc)
        return ""

    match = re.search(r"(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}", output)
    mac = match.group(0) if match else ""
    mac_cache[ip] = (now, mac)
    return mac

def platform_info(ip):
    state = client_states.get(ip)
    if state is None:
        return ('','',)
    return (state["os"], state["os_version"])

def parse_android_major_version(version):
    match = re.match(r"^(\d+)", version or "")
    return int(match.group(1)) if match else None
        
def timeout_info(ip):
    state = client_states.get(ip)
    if state is None:
        return (0,0,0,)
    return [
        state["current_ts"],
        state["lasttimestamp"],
        state["send204after"],
    ]
        
def is_inactive(ip):
    ts=tstamp(datetime.datetime.now(tzutc()))
    current_ts, last_ts, send204after = timeout_info(ip) 
    logger.debug("In is_inactive. current_ts:{}. last_ts:{}. send204after:{}".format(current_ts,last_ts,send204after,))
    if not last_ts:
        return True
    if ts - int(last_ts) > INACTIVITY_TO:
        return True
    else:
        return False

def is_after204_timeout(ip):
    ts=tstamp(datetime.datetime.now(tzutc()))
    current_ts, last_ts, send204after = timeout_info(ip) 
    if send204after == 0: return False
    logger.debug("function: is_after204_timeout send204after:{} current: {}".format(send204after,ts,))
    if not send204after:
        return False
    if ts - int(send204after) > 0:
        return True
    else:
        return False

def set_204after(ip,value):
    ts=tstamp(datetime.datetime.now(tzutc()))
    get_client_state(ip)["send204after"] = ts + value

def set_lasttimestamp(ip):
    ts=tstamp(datetime.datetime.now(tzutc()))
    get_client_state(ip)["lasttimestamp"] = ts

def set_portal_completed(ip):
    get_client_state(ip)["portal_completed"] = True

def clear_portal_completed(ip):
    get_client_state(ip).update(
        portal_completed=False,
        lasttimestamp=0,
        send204after=0,
    )

def is_portal_completed(ip):
    state = client_states.get(ip)
    return bool(state and state["portal_completed"])

def client_ip(environ):
    '''Single source of the client address.  nginx overrides X-Forwarded-For
    with the real peer address (uwsgi_param HTTP_X_FORWARDED_FOR $remote_addr);
    direct runs fall back to the peer address itself.'''
    forwarded = environ.get('HTTP_X_FORWARDED_FOR')
    if forwarded:
        return forwarded.strip()
    return environ['REMOTE_ADDR'].strip()

