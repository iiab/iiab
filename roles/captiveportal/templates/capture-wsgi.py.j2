@lru_cache(maxsize=4)
def read_static_asset(relative_path):
    with open(os.path.join(doc_root, relative_path), "rb") as asset:
        return asset.read()

def static_asset(environ, start_response, relative_path, content_type):
    asset = read_static_asset(relative_path)
    headers = [
        ('Content-type', content_type),
        ('Content-Length', str(len(asset))),
        ('Cache-Control', 'public, max-age=86400'),
    ]
    start_response('200 OK', headers)
    return [asset]

