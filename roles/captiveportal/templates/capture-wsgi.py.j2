CAPTIVE_SPLASH = "/captive_splash"
INFORMATIONAL_SPLASH_PATHS = (
    CAPTIVE_SPLASH,
    "/mac_splash",
    "/android_splash",
    "/android_https",
)
APPLE_SUCCESS_BODY = "<HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>"
