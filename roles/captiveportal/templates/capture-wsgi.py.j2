# ########## transient client state ##############
client_states = {}

def new_client_state():
    return {
        "mac": "",
        "portal_completed": False,
        "splash_until": 0,
        "os": "",
        "os_version": "",
        "last_seen": time.monotonic(),
    }

def prune_client_states():
    now = time.monotonic()
    expired = [
        ip for ip, state in client_states.items()
        if now - state["last_seen"] > CLIENT_STATE_TTL
    ]
    for ip in expired:
        del client_states[ip]
    # Expired mac_cache entries are removed so MACs do not outlive their
    # usefulness in process memory.
    stale = [
        ip for ip, cached in mac_cache.items()
        if now - cached[0] > MAC_CACHE_TTL
    ]
    for ip in stale:
        del mac_cache[ip]

def get_client_state(ip):
    state = client_states.get(ip)
    if state is None:
        state = new_client_state()
        client_states[ip] = state
    return state

mac_cache = {}

def update_client_state(ip, mac, system, system_version):
    state = get_client_state(ip)
    # State resets only on a genuine device change: two known, differing MACs.
    # An empty MAC means the lookup degraded (no neighbor entry yet,
    # timeout) -- "unknown" must not be treated as "changed" or a single
    # transient failure would wipe portal_completed mid-session.
    if mac and state["mac"] and state["mac"] != mac:
        state.update(
            mac=mac,
            os=system,
            os_version=system_version,
            portal_completed=False,
            splash_until=0,
        )
    else:
        state.update(os=system, os_version=system_version)
        if mac: # never overwrite a known MAC with an unknown one
            state["mac"] = mac

def get_mac(ip):
    now = time.monotonic()
    cached = mac_cache.get(ip)
    if cached and now - cached[0] < MAC_CACHE_TTL:
        return cached[1]

    # iproute2's `ip neigh` resolves IPv4 and IPv6 neighbors alike (net-tools'
    # `arp` rejects IPv6 addresses with exit 255). Unexpected input, timeouts,
    # and missing binaries yield "no MAC" and let the request continue. Failed
    # lookups are not cached; subsequent requests retry, and successful
    # lookups (including "no entry") are cached.
    try:
        output = subprocess.check_output(
            ["ip", "neigh", "show", "to", ip],
            text=True,
            stderr=subprocess.PIPE,
            timeout=NEIGHBOR_LOOKUP_TIMEOUT,
        )
    except subprocess.CalledProcessError as exc:
        logger.debug("neighbor lookup rejected %r: %s", ip, (exc.stderr or "").strip())
        return ""
    except (subprocess.SubprocessError, OSError) as exc:
        logger.warning("neighbor lookup failed for %r: %s", ip, exc)
        return ""

    match = re.search(r"(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}", output)
    mac = match.group(0) if match else ""
    mac_cache[ip] = (now, mac)
    return mac

def set_portal_completed(ip):
    get_client_state(ip)["portal_completed"] = True

def clear_portal_completed(ip):
    get_client_state(ip).update(
        portal_completed=False,
        splash_until=0,
    )

def is_portal_completed(ip):
    state = client_states.get(ip)
    return bool(state and state["portal_completed"])

def portal_session_active(ip):
    '''True while this client's portal completion remains active. Each request
    refreshes last_seen, so the session survives while the device talks to the
    portal. Silence lasting PORTAL_SESSION_TO expires the completion and its
    state together, and a later connection must complete the portal again.'''
    if not is_portal_completed(ip):
        return False
    state = client_states[ip]
    if time.monotonic() - state["last_seen"] <= PORTAL_SESSION_TO:
        return True
    logger.debug("portal completion expired for %s; starting a new session", ip)
    clear_portal_completed(ip)
    return False

def splash_waiting(ip):
    '''Keep an informational splash visible briefly, then complete the client.'''
    state = get_client_state(ip)
    deadline = state["splash_until"]
    if deadline:
        if time.monotonic() < deadline:
            return True
        state["splash_until"] = 0
        set_portal_completed(ip)
        return False
    state["splash_until"] = time.monotonic() + SPLASH_DISPLAY_TO
    return True

def client_ip(environ):
    '''Single source of the client address.  nginx overrides X-Forwarded-For
    with the real peer address (uwsgi_param HTTP_X_FORWARDED_FOR $remote_addr);
    direct runs fall back to the peer address itself.'''
    forwarded = environ.get('HTTP_X_FORWARDED_FOR')
    if forwarded:
        return forwarded.strip()
    return environ['REMOTE_ADDR'].strip()

#  ###################  Action routines based on OS  ################3
def generic_probe(environ, start_response):
    logger.debug('in generic_probe')
    ip = client_ip(environ)
    if portal_session_active(ip):
        return probe_success(environ, start_response)
    if is_android_flow(environ):
        logger.debug("sending captive portal instructions for Android")
        return informational_splash(environ, start_response)
    return put_302(environ, start_response)

def informational_splash(environ, start_response):
    ip = client_ip(environ)
    if portal_session_active(ip):
        return probe_success(environ, start_response)
    splash_waiting(ip)
    if portal_session_active(ip):
        return probe_success(environ, start_response)
    system, _ = parse_agent(environ.get('HTTP_USER_AGENT', ''))
    close_hint = "You may close this window." if system == "OS X" else "You may close this page."
    en_txt = {
        'message': "This network provides offline access.",
        'close_hint': close_hint,
        'HOME_URL': CAPTIVE_PORTAL_HOME,
        'manual_home_prompt': "Open a regular browser and enter one of these:",
        'manual_addresses': manual_addresses,
        'doc_root': get_iiab_env("WWWROOT"),
    }
    es_txt = {
        'message': "Esta red ofrece acceso sin conexión.",
        'close_hint': "Puede cerrar esta ventana." if system == "OS X" else "Puede cerrar esta página.",
        'HOME_URL': CAPTIVE_PORTAL_HOME,
        'manual_home_prompt': "Abra un navegador normal e introduzca una de estas:",
        'manual_addresses': manual_addresses,
        'doc_root': get_iiab_env("WWWROOT"),
    }
    txt = en_txt if lang == "en" else es_txt if lang == "es" else en_txt
    response_body = str(j2_env.get_template("simple.template").render(**txt))
    response_body = response_body.encode()
    status = '200 OK'
    response_headers = [
        ('Content-type', 'text/html; charset=utf-8'),
        ('Content-Length', str(len(response_body))),
    ]
    start_response(status, response_headers)
    return [response_body]

def android(environ, start_response):
    ip = client_ip(environ)
    if splash_waiting(ip):
        return put_302(environ, start_response, CAPTIVE_SPLASH)
    return put_204(environ, start_response)

def macintosh(environ, start_response):
    logger.debug('in macintosh')
    ip = client_ip(environ)
    if portal_session_active(ip):
        return probe_success(environ, start_response)
    if is_android_flow(environ):
        return informational_splash(environ, start_response)
    if splash_waiting(ip):
        return put_302(environ, start_response, CAPTIVE_SPLASH)
    if portal_session_active(ip):
        return probe_success(environ, start_response)
    # Windows/NCSI browsers go straight to the homepage.  iOS/macOS sign-in
    # assistants and Safari need the sign-in splash page below, so macOS
    # follows the same flow as iPhone OS.
    system, _ = parse_agent(environ.get('HTTP_USER_AGENT', ''))
    if system in ("Windows NT", "Microsoft NCSI"):
        return put_302(environ, start_response)
    # Nodogsplash keeps a pre-authenticated client on the splash page until
    # that client authenticates.  Do not infer completion from a repeated
    # connectivity probe; redirect the probe to the splash page first so
    # Apple clients invoke their captive-network assistant.
    return put_302(environ, start_response, CAPTIVE_SPLASH)

# =============  Return html pages  ============================
@lru_cache(maxsize=4)
def read_static_asset(relative_path):
    with open(os.path.join(doc_root, relative_path), "rb") as asset:
        return asset.read()

def static_asset(environ, start_response, relative_path, content_type):
    asset = read_static_asset(relative_path)
    headers = [
        ('Content-type', content_type),
        ('Content-Length', str(len(asset))),
        ('Cache-Control', 'public, max-age=86400'),
    ]
    start_response('200 OK', headers)
    return [asset]

def bootstrap(environ, start_response):
    logger.debug("in bootstrap")
    return static_asset(environ, start_response, "common/js/bootstrap.min.js", "text/javascript")

def jquery(environ, start_response):
    logger.debug("in jquery")
    return static_asset(environ, start_response, "common/js/jquery.min.js", "text/javascript")

def bootstrap_css(environ, start_response):
    logger.debug("in bootstrap_css")
    return static_asset(environ, start_response, "common/css/bootstrap.min.css", "text/css")

def null(environ, start_response):
    status = '404 Not Found'
    headers = [('Content-type', 'text/html')]
    start_response(status, headers)
    return [b""]

def success(environ, start_response, body=APPLE_SUCCESS_BODY):
    status = '200 ok'
    html = body.encode()
    headers = [('Content-type', 'text/html')]
    start_response(status, headers)
    return [html]

def put_204(environ, start_response):
    status = '204 No Content'
    response_body = b''
    response_headers = [('Content-type','text/html'),
            ('Content-Length',str(len(response_body)))]
    start_response(status, response_headers)
    logger.debug("in function  put_204: sending 204 html response")
    return [response_body]

def put_302(environ, start_response, location=CAPTIVE_PORTAL_HOME):
    status = '302 Moved Temporarily'
    response_body = b''
    if location is None:
        location = CAPTIVE_PORTAL_HOME
    response_headers = [('Content-type','text/html'),
            ('Location',location), 
            ('Content-Length',str(len(response_body)))]
    start_response(status, response_headers)
    logger.debug("in function  put_302: sending 302 html response")
    return [response_body]

def plain_200(environ, start_response, body):
    payload = body.encode()
    start_response('200 OK', [
        ('Content-type', 'text/plain; charset=utf-8'),
        ('Content-Length', str(len(payload))),
        ('Cache-Control', 'no-store'),
    ])
    return [payload]

def captive_portal_api(environ, start_response):
    ip = client_ip(environ)
    if not portal_session_active(ip) and get_client_state(ip)["splash_until"]:
        splash_waiting(ip)
    captive = not portal_session_active(ip)
    response = {
        "captive": captive,
        "user-portal-url": "http://captive.lan/captive_splash",
    }
    payload = json.dumps(response, separators=(",", ":")).encode()
    start_response('200 OK', [
        ('Content-type', 'application/captive+json'),
        ('Content-Length', str(len(payload))),
        ('Cache-Control', 'no-store'),
    ])
    return [payload]

# Path shapes of connectivity probes that reach us under an unrecognized
# hostname (OEM forks, clients using their own DNS, and similar cases).
# Regular browsing redirects to the IIAB homepage.
PROBE_PATH_HINTS = ('generate_204', 'gen_204', 'connecttest', 'success.txt',
                    'hotspot-detect', 'ncsi.txt', 'connectivitycheck')

def looks_like_probe(path):
    return any(hint in path for hint in PROBE_PATH_HINTS)

def probe_success(environ, start_response):
    '''Answer a connectivity probe with exactly what its OS expects for a
    completed portal session. The client shows a clean "connected" verdict
    rather than "Limited connection" / "No internet access" on an offline
    IIAB box. Unrecognized probes receive the generic success answer,
    204 No Content.'''
    host = environ.get('HTTP_HOST', '')
    path = environ.get('PATH_INFO', '')
    logger.debug("probe_success host: {} path: {}".format(host, path))
    if host in BROWSER_PROBE_RESPONSES:
        response_body = BROWSER_PROBE_RESPONSES[host]
        if response_body is None:
            return put_204(environ, start_response)
        return plain_200(environ, start_response, response_body)
    if host in LINUX_PROBE_RESPONSES:
        response_body = LINUX_PROBE_RESPONSES[host]
        if response_body is None:
            return put_204(environ, start_response)
        return plain_200(environ, start_response, response_body)
    if host in WINDOWS_PROBE_RESPONSES:
        response_body = WINDOWS_PROBE_RESPONSES[host]
        if response_body is None:
            return put_204(environ, start_response)
        return plain_200(environ, start_response, response_body)
    if host in APPLE_PROBE_RESPONSES:
        return success(environ, start_response, APPLE_PROBE_RESPONSES[host])
    # Substring matches cover CDN and regional hostnames not listed above.
    if 'firefox' in host:
        return plain_200(environ, start_response, 'success')
    if 'msftconnecttest' in host or 'msftncsi' in host or \
       path.endswith(('connecttest.txt', 'ncsi.txt')):
        return plain_200(environ, start_response, 'Microsoft Connect Test')
    if 'apple' in host:
        return success(environ, start_response)
    return put_204(environ, start_response)

def parse_agent(agent):
    system = ''
    system_version = ''
    match = re.search(r"(Android)\s([.\d]*)",agent)
    if match:
        system = match.group(1)
        system_version = match.group(2)
    match = re.search(r"(OS X)\s([\d_]*)",agent)
    if match:
        system = match.group(1)
        system_version = match.group(2)
    match = re.search(r"(iPhone OS)\s([\d_]*)",agent)
    if match:
        system = match.group(1)
        system_version = match.group(2)
    match = re.search(r"(Windows NT)\s([\d.]*)",agent)
    if match:
        system = match.group(1)
        system_version = match.group(2)
    match = re.search(r"(Microsoft NCSI)",agent)
    if match:
        system = match.group(1)
        system_version = "8"
    return (system, system_version)

def is_android_flow(environ):
    agent = environ.get('HTTP_USER_AGENT', '')
    system, _ = parse_agent(agent)
    return (
        environ.get("PATH_INFO") == CAPTIVE_SPLASH
        or system == "Android"
    )

def requested_url(environ):
    host = environ.get("HTTP_HOST") or environ.get("SERVER_NAME", "")
    path = environ.get("PATH_INFO", "")
    query = environ.get("QUERY_STRING", "")
    if query:
        path += "?" + query
    return "http://{}{}".format(host, path)

#
# ================== Start serving the wsgi application  =================
def application (environ, start_response):
   if args.log_probes:
      logger.info(
          "probe URL requested: %s (server name: %s)",
          requested_url(environ),
          environ.get("SERVER_NAME", ""),
      )

   path = environ['PATH_INFO']

   # These resources do not need client state or neighbor lookup.
   if path == "/iiab_banner6.png":
      return static_asset(
          environ, start_response, "js-menu/menu-files/images/iiab_banner6.png", "image/png"
      )
   if path == "/bootstrap.min.js":
      return bootstrap(environ, start_response)
   if path == "/bootstrap.min.css":
      return bootstrap_css(environ, start_response)
   if path == "/jquery.min.js":
      return jquery(environ, start_response)
   if path == "/favicon.ico":
      return null(environ, start_response)

   ip = client_ip(environ)
   prune_client_states()
   mac = get_mac(ip)
   agent = environ.get('HTTP_USER_AGENT','default_agent')

   # Client activity is recorded in transient in-memory state.
   state = get_client_state(ip)
   state["last_seen"] = time.monotonic()

   system,system_version = parse_agent(agent)
   if system != '':
      update_client_state(ip, mac, system, system_version)

   #######   Return pages based upon PATH   ###############
   # do more specific stuff first
   if path == "/home_selected":
      # Keep this legacy endpoint idempotent for clients with a cached splash
      # page; current splash pages complete clients automatically.
      logger.debug("function: home_selected. Marking client portal complete")
      set_portal_completed(ip)
      if system in ("OS X", "iPhone OS"):
         return put_302(environ, start_response, "/hotspot-detect.html")
      return put_204(environ, start_response)

   if path == "/.well-known/captive-portal":
      return captive_portal_api(environ, start_response)

   if path in INFORMATIONAL_SPLASH_PATHS:
      return informational_splash(environ, start_response)

   host = environ['HTTP_HOST']

   #### parse OS platform based upon URL  ##################
   if host in APPLE_PROBE_RESPONSES:
      return macintosh(environ, start_response)

   if host in BROWSER_PROBE_RESPONSES:
      if portal_session_active(ip):
          return probe_success(environ, start_response)
      if is_android_flow(environ):
          return android(environ, start_response)
      return generic_probe(environ, start_response)

   if host in ANDROID_PROBE_RESPONSES or path in ANDROID_PROBE_PATHS:
      if portal_session_active(ip):
          return put_204(environ,start_response)
      # Non-Android /generate_204 gets a redirect for the Chromium "Open in browser" fallback.
      if path == "/generate_204" and not is_android_flow(environ):
          return put_302(environ, start_response)
      return android(environ, start_response)

   # desktop connectivity probes
   if (
      host in WINDOWS_PROBE_RESPONSES
      or host in LINUX_PROBE_RESPONSES
      or host == "detectportal.firefox.com"
      or path == "/static/hotspot.txt"
   ):
      return generic_probe(environ, start_response)

   # A path that any OS uses to probe for a portal, under an unrecognized
   # hostname, receives the portal-probe response. This prevents homepage HTML
   # from loading in a tab that can hang (e.g. GNOME's Fedora portal check).
   if looks_like_probe(path):
      return generic_probe(environ, start_response)

   # Under an unknown hostname, a request that is not a probe gets the IIAB
   # homepage.
   logger.debug("executing the default 302 response")
   return put_302(environ,start_response)

# Instantiate the server
if __name__ == "__main__":
    httpd = make_server (
    "", # The host name
    PORT, # A port number where to wait for the request
    application # The application object name, in this case a function
    )

    httpd.serve_forever()
