def parse_args():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument(
        "--log-probes",
        "--log-urls",
        dest="log_probes",
        action="store_true",
        default=os.environ.get(
            "CAPTIVE_PORTAL_LOG_PROBES",
            "{{ captiveportal_log_probes | default(false) | string }}",
        ).lower() in ("1", "true", "yes", "on"),
    )
    parser.add_argument("--log-file", default=os.environ.get("CAPTIVE_PORTAL_LOG_FILE"))
    parser.add_argument(
        "--port",
        type=int,
        default=os.environ.get("CAPTIVE_PORTAL_PORT", "9090"),
    )
    return parser.parse_known_args()[0]

def configure_logging(args):
    handlers = [logging.StreamHandler(sys.stderr)]
    if args.log_file:
        handlers.append(
            RotatingFileHandler(args.log_file, maxBytes=100000, backupCount=2)
        )

    logging.basicConfig(
        format='%(asctime)s.%(msecs)03d:%(name)s:%(message)s',
        datefmt='%M:%S',
        level=logging.DEBUG if args.verbose else logging.INFO,
        handlers=handlers,
    )
    return logging.getLogger(__name__)


