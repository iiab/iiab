# portal_completed marks a client that has completed the automatic splash flow.
# A completed client receives the success answer its OS expects -- 204 for
# Android/Chromium, "success" for Firefox, "Microsoft Connect Test" for
# Windows NCSI, and Apple's Success page for iOS/macOS -- and shows a clean
# connected status. Incomplete clients receive the shared informational splash
# or an OS-specific redirect.

# Create the jinja2 environment.
CAPTIVE_PORTAL_BASE = "/opt/iiab/captiveportal"
j2_env = Environment(loader=FileSystemLoader(CAPTIVE_PORTAL_BASE),trim_blocks=True)

# How long a completed portal session (and its client state) survives without
# any request from that client.  1 hour so a device that is in active use is
# never re-prompted: Windows/Android usually probe at least every few minutes,
# but a client that goes quiet must not be sent back through the splash page.
PORTAL_SESSION_TO = 60 * 60
# Keep the shared informational page visible long enough for a captive assistant to
# render it before its next probe completes the client.
SPLASH_DISPLAY_TO = 5
CLIENT_STATE_TTL = PORTAL_SESSION_TO
# Neighbor lookups are short-lived because a client can change networks while
# retaining the same address.
MAC_CACHE_TTL = 30
NEIGHBOR_LOOKUP_TIMEOUT = 2 # seconds; a wedged netlink must not stall requests


