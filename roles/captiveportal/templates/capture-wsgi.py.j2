def parse_agent(agent):
    system = ''
    system_version = ''
    match = re.search(r"(Android)\s([.\d]*)",agent)
    if match:
        system = match.group(1)
        system_version = match.group(2)
    match = re.search(r"(OS X)\s([\d_]*)",agent)
    if match:
        system = match.group(1)
        system_version = match.group(2)
    match = re.search(r"(iPhone OS)\s([\d_]*)",agent)
    if match:
        system = match.group(1)
        system_version = match.group(2)
    match = re.search(r"(Windows NT)\s([\d.]*)",agent)
    if match:
        system = match.group(1)
        system_version = match.group(2)
    match = re.search(r"(Microsoft NCSI)",agent)
    if match:
        system = match.group(1)
        system_version = "8"
    return (system, system_version)

def is_android_flow(environ):
    agent = environ.get('HTTP_USER_AGENT', '')
    system, system_version = parse_agent(agent)
    return (
        environ.get("PATH_INFO") == ANDROID_CAPTIVE_SPLASH
        or system == "Android"
    )

def dismiss_hint(environ):
    '''One concise sentence telling the user how to dismiss the OS sign-in
    window when it does not close on its own.'''
    agent = environ.get('HTTP_USER_AGENT','default_agent')
    system, system_version = parse_agent(agent)
    if is_android_flow(environ):
        en = 'If this page stays open, tap the three dots and choose "Use this network as is".'
        es = 'Si esta página permanece abierta, toque los tres puntos y elija "Usar esta red tal como está".'
    elif system == 'iPhone OS':
        en = "If this page stays open, tap Cancel (or swipe down) to dismiss it."
        es = "Si esta página permanece abierta, toque Cancelar (o deslice hacia abajo) para cerrarla."
    elif system == 'OS X':
        en = "If this page stays open, close it (Command-W)."
        es = "Si esta página permanece abierta, ciérrela (Command-W)."
    else:
        en = "If this page stays open, you can close or ignore it."
        es = "Si esta página permanece abierta, puede cerrarla o ignorarla."
    return es if lang == "es" else en

def requested_url(environ):
    host = environ.get("HTTP_HOST") or environ.get("SERVER_NAME", "")
    path = environ.get("PATH_INFO", "")
    query = environ.get("QUERY_STRING", "")
    if query:
        path += "?" + query
    return "http://{}{}".format(host, path)

