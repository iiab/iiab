<!DOCTYPE html>
<html>
  <head>
    <title>Welcome to IIAB</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="data:,">
    {% if auto_refresh %}
    <meta http-equiv="refresh" content="{{ auto_refresh_seconds }};url={{ auto_refresh_url }}">
    {% endif %}
<!--    <link rel="stylesheet" href="/bootstrap.min.css"/>
    <script src="/bootstrap.min.js"></script> -->
    <style type="text/css">
      *, *::before, *::after {
          box-sizing: border-box;
      }
      body {
          background-color: #CBFFAA;
          font-family: sans-serif;
          font-size: 100%;
          line-height: 1.4;
          margin: 0;
          min-height: 100vh;
          padding: 16px 20px 32px;
          overflow-wrap: break-word;
          -webkit-text-size-adjust: 100%;
      }
      #header {
          display: block;
          width: 100%;
          max-width: 100%;
          height: 120px;
          margin: 8px auto 24px;
          border-radius: 5px;
          background: #73b9ff url('iiab_banner6.png') no-repeat center center;
          background-size: contain;
      }
      .content {
          max-width: 40em;
          margin: 0 auto;
          text-align: center;
      }
      h1 {
          margin: 0 0 1em;
          font-size: 1.6em;
      }
      p {
          margin: 0.8em 0;
      }
      .manual-home-url {
           display: block;
           width: 100%;
           margin: 0.25em 0;
           border-radius: 5px;
           font-size: 1.6em;
           font-weight: bold;
           overflow-wrap: anywhere;
           padding: 0.4em 0.5em;
           cursor: pointer;
           -webkit-user-select: text;
           user-select: text;
      }
      .manual-home-url:hover,
      .manual-home-url:focus-visible {
           background: #fff;
           outline: 2px solid #249;
      }
      .dismiss-hint {
           font-size: 0.9em;
           color: #444;
      }
    </style>
    <script>
     function copyAddress(el) {
        if (!el.getAttribute("data-orig")) {
          el.setAttribute("data-orig", el.textContent);
        }
        var text = el.getAttribute("data-orig");
        var legacyCopy = function() {
          var ta;
          try {
            ta = document.createElement("textarea");
            ta.value = text;
            ta.setAttribute("readonly", "");
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
          } catch (e) {
          } finally {
            if (ta && ta.parentNode) { ta.parentNode.removeChild(ta); }
          }
        };
        // This HTTP page may not expose navigator.clipboard; use execCommand
        // as a fallback.
        if (navigator.clipboard && window.isSecureContext) {
          try {
            navigator.clipboard.writeText(text).catch(legacyCopy);
          } catch (e) {
            legacyCopy();
          }
        } else {
          legacyCopy();
        }
     }
     function copyAddressKey(event) {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          copyAddress(event.currentTarget);
        }
     }

    </script>
  </head>
  <body>
     <div id="header"></div>
     <div class="content">
       <h1>Welcome to IIAB</h1>
       <p>{{ message }}</p>
       {% if manual_addresses is defined %}
       <p>{{ manual_home_prompt }}</p>
       {% for addr in manual_addresses %}
       <p class="manual-home-url" title="Copy address" role="button" tabindex="0" aria-label="Copy {{ addr }}" onclick="copyAddress(this)" onkeydown="copyAddressKey(event)">{{ addr }}</p>
       {% endfor %}
       {% endif %}
       {% if close_hint is defined %}
       <p class="dismiss-hint">{{ close_hint }}</p>
       {% endif %}
     </div>
  </body>
</html>
