<!DOCTYPE html>
<html>
  <head>
    <title>Success</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="data:,">
<!--    <link rel="stylesheet" href="/bootstrap.min.css"/>
    <script src="/bootstrap.min.js"></script> -->
    <style type="text/css">
      *, *::before, *::after {
          box-sizing: border-box;
      }
      body {
          background-color: #CBFFAA;
          font-family: sans-serif;
          font-size: 100%;
          line-height: 1.4;
          margin: 0;
          min-height: 100vh;
          padding: 16px 20px 32px;
          overflow-wrap: break-word;
          -webkit-text-size-adjust: 100%;
      }
      #header {
          display: block;
          width: 100%;
          max-width: 100%;
          height: 120px;
          margin: 8px auto 24px;
          border-radius: 5px;
          background: #73b9ff url('iiab_banner6.png') no-repeat center center;
          background-size: contain;
      }
      .content {
          max-width: 40em;
          margin: 0 auto;
          text-align: center;
      }
      h1 {
          margin: 0 0 1em;
          font-size: 1.6em;
      }
      p {
          margin: 0.8em 0;
      }
      .success-token {
          margin: 0 0 0.5em;
          font-size: 0.9em;
      }
      .button {
           display: inline-block;
           max-width: 100%;
           margin: 8px;
           padding: 10px 16px;
           font: bold 14px Arial;
           text-align: center;
           text-decoration: none;
           white-space: normal;
           background-color: #EEEEEE;
           color: #333333;
           border-top: 1px solid #CCCCCC;
           border-right: 1px solid #333333;
           border-bottom: 1px solid #333333;
           border-left: 1px solid #CCCCCC;
           border-radius: 5px;
      }
      .manual-home-url {
           font-size: 1.6em;
           font-weight: bold;
           overflow-wrap: anywhere;
           padding: 0.4em 0;
           cursor: pointer;
      }
      .copy-hint {
           font-size: 0.85em;
           color: #555;
           margin-top: 0;
      }
      .dismiss-hint {
           font-size: 0.9em;
           color: #444;
      }
    </style>
    <script>
     var w = window.innerWidth;
     function homeclick(){
        if (navigator.sendBeacon) {
          navigator.sendBeacon("/home_selected", "");
        } else {
          var request = new XMLHttpRequest();
          request.open("GET", "/home_selected", false);
          request.send();
        }
        window.open("{{ HOME_URL }}","_system");
     }

     function copyAddress(el) {
        if (!el.getAttribute("data-orig")) {
          el.setAttribute("data-orig", el.textContent);
        }
        var text = el.getAttribute("data-orig");
        var legacyCopy = function() {
          var ta;
          try {
            ta = document.createElement("textarea");
            ta.value = text;
            ta.setAttribute("readonly", "");
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
          } catch (e) {
          } finally {
            if (ta && ta.parentNode) { ta.parentNode.removeChild(ta); }
          }
        };
        // This page is plain http:// -- usually not a secure context -- so
        // navigator.clipboard is often missing; fall back to execCommand.
        if (navigator.clipboard && window.isSecureContext) {
          try {
            navigator.clipboard.writeText(text).catch(legacyCopy);
          } catch (e) {
            legacyCopy();
          }
        } else {
          legacyCopy();
        }
     }

    </script>
  </head>
  <body>
     <div id="header"></div>
     <div class="content">
       {% if success_token is defined %}
       <p class="success-token">Success</p>
       {% endif %}
       <h1>Welcome to IIAB</h1>
       <p>{{ message }}</p>
       {% if dismiss_hint is defined %}
       <p class="dismiss-hint">{{ dismiss_hint }}</p>
       {% endif %}
       {% if manual_home_url is defined %}
       <p>{{ manual_home_prompt }}</p>
       <p class="manual-home-url" title="Tap to copy" onclick="copyAddress(this)">{{ manual_home_url }}</p>
       <p class="copy-hint">Tap the address to copy it</p>
       {% endif %}
       <div id="choices">
          {% if btn2 is defined %}
          <a class="button" href="https://captive.lan/android_splash">{{ btn2 }}</a>
          {% endif %}
          <a class="button" href="{{ HOME_URL }}" target="_blank" rel="noopener" onclick="homeclick(); return false;">{{ btn1 }}</a>
       </div>
     </div>
  </body>
</html>
