[Unit]
Description=Zimantic search server
After=syslog.target network.target local-fs.target

[Service]
Type=simple
User={{ zimantic_user }}
Group={{ zimantic_user }}
WorkingDirectory={{ zimantic_data_dir }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ zimantic_venv }}/bin/zimantic serve{{ ' --fast' if zimantic_mode == 'fast' else '' }}
Restart=always
RestartSec=3s
TimeoutStartSec=180
MemoryMax={{ zimantic_memory_max }}
OOMScoreAdjust={{ zimantic_oom_score_adjust }}

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths={{ zimantic_data_dir }}
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
