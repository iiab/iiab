[Unit]
Description=Zimantic ZIM search server
After=syslog.target network.target local-fs.target
# Do not restart forever when Zimantic cannot fit in memory: after a few starts
# in the interval, leave the unit failed so the OOM is visible.
StartLimitIntervalSec={{ zimantic_start_limit_interval }}
StartLimitBurst={{ zimantic_start_limit_burst }}

[Service]
Type=simple
User={{ zimantic_user }}
Group={{ zimantic_user }}
WorkingDirectory={{ zimantic_data_dir }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ zimantic_venv }}/bin/zimantic serve{{ ' --fast' if zimantic_mode == 'fast' else '' }}
Restart=always
RestartSec={{ zimantic_restart_sec }}
TimeoutStartSec=180
MemoryHigh={{ zimantic_memory_high }}
MemoryMax={{ zimantic_memory_max }}
OOMScoreAdjust={{ zimantic_oom_score_adjust }}
OOMPolicy=stop

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths={{ zimantic_data_dir }}
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
