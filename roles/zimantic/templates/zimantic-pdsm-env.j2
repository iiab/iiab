# Managed by IIAB's zimantic role.
# Sourced by /usr/local/pdsm/services-available/zimantic. It carries the paths
# and serve flags that a systemd unit would otherwise define.
ZIMANTIC_BIN="{{ zimantic_venv }}/bin/zimantic"
ZIMANTIC_DATA_DIR="{{ zimantic_data_dir }}"
ZIMANTIC_SERVE_FLAGS="{{ '--fast' if zimantic_mode == 'fast' else '' }}"
ZIMANTIC_LOG="/var/log/zimantic.log"
