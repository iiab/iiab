# Zimantic uses absolute root routes, so the canonical URL is its dedicated
# port. This shortcut avoids duplicating or rewriting the application UI.
location = {{ zimantic_url_without_slash }} {
    return 302 http://$host:{{ zimantic_port }}/;
}

location = {{ zimantic_url }} {
    return 302 http://$host:{{ zimantic_port }}/;
}

