# Zimantic serves absolute application routes below its configured base path.
# NGINX strips that prefix before proxying to the root-mounted application.
location = {{ zimantic_url_without_slash }} {
    return 302 {{ zimantic_url }};
}

location ^~ {{ zimantic_url }} {
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix {{ zimantic_url_without_slash }};
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # A cold, multi-source search on a Pi can take longer than NGINX's 60 s
    # default read timeout, especially before the first streamed progress
    # event. Match the Kiwix role's generous budget so a slow search ends with
    # results instead of a 504 Gateway Timeout. The read timer only runs while
    # no bytes arrive; the stream sends progress about every 0.7 s.
    proxy_connect_timeout {{ zimantic_nginx_connect_timeout }};
    proxy_send_timeout {{ zimantic_nginx_timeout }};
    proxy_read_timeout {{ zimantic_nginx_timeout }};
    send_timeout {{ zimantic_nginx_timeout }};
    # Stream search progress events instead of buffering them in NGINX.
    proxy_buffering off;
    proxy_pass http://127.0.0.1:{{ zimantic_port }}/;
}

{% if not kiwix_enabled %}
# When kiwix-serve is disabled, keep the familiar Kiwix URL pointed at Zimantic.
location = {{ kiwix_url | default('/kiwix') }} {
    return 302 {{ zimantic_url }};
}

location = {{ kiwix_url_plus_slash | default((kiwix_url | default('/kiwix')) ~ '/') }} {
    return 302 {{ zimantic_url }};
}
{% endif %}
