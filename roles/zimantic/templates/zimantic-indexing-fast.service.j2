# Managed by IIAB's zimantic role.

[Unit]
Description=Index new ZIMs quickly and rescan Zimantic
After=local-fs.target
RequiresMountsFor={{ zimantic_zim_dir }} {{ zimantic_data_dir }}

[Service]
Type=oneshot
User={{ zimantic_user }}
Group={{ zimantic_user }}
WorkingDirectory={{ zimantic_data_dir }}
# Scanning and building a large library opens many indexes and archives.
LimitNOFILE=65536
ExecStart=/usr/local/sbin/zimantic-indexing --fast
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths={{ zimantic_data_dir }}
