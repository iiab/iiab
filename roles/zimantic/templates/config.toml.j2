# Managed by IIAB's zimantic role.
zim_dir = "{{ zimantic_zim_dir }}"
model_dir = "{{ zimantic_model_dir }}"
index_dir = "{{ zimantic_index_dir }}"

# File types indexed when "zimantic build" scans a folder. By default, only
# ZIMs are indexed. Add extensions or named profiles (text, ebook, docs, office,
# media, video, audio, image, comic, archive, all, all+unknown) to index
# ordinary files alongside the ZIMs.
file_types = {{ zimantic_file_types | to_json }}

# Ordinary-file extraction bounds.
file_timeout = {{ zimantic_file_timeout }}
max_file_text_chars = {{ zimantic_max_file_text_chars }}
archive_depth = {{ zimantic_archive_depth }}
max_archive_members = {{ zimantic_max_archive_members }}
max_archive_bytes = {{ zimantic_max_archive_bytes }}
max_ocr_pages = {{ zimantic_max_ocr_pages }}
ocr = {{ 'true' if zimantic_ocr | bool else 'false' }}
ocr_languages = "{{ zimantic_ocr_languages }}"
asr = {{ 'true' if zimantic_asr | bool else 'false' }}
asr_model = "{{ zimantic_asr_model }}"

port = {{ zimantic_port }}
web_base_path = "{{ zimantic_url_without_slash }}"
kiwix_url = ""
kiwix_server = ""

# Low-memory settings suitable for a Raspberry Pi Zero 2 W.
page_size = 10
max_results = 50
batch_size = 8
build_workers = 1
embed_threads = 2
embedding_workers = 1
search_workers = 2
max_concurrent_searches = 2
candidate_count = 16
max_stream_ranks = 8
cache_size = 64
cache_bytes = 8388608
source_timeout = 12
