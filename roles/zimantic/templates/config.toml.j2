# Managed by IIAB's zimantic role.
zim_dir = "{{ zimantic_zim_dir }}"
model_dir = "{{ zimantic_model_dir }}"
index_dir = "{{ zimantic_index_dir }}"

port = {{ zimantic_port }}
web_base_path = "{{ zimantic_url_without_slash }}"
kiwix_url = ""
kiwix_server = ""

# Low-memory settings suitable for a Raspberry Pi Zero 2 W.
page_size = 10
max_results = 50
batch_size = 8
build_workers = 1
embed_threads = 2
embedding_workers = 1
search_workers = 2
max_concurrent_searches = 2
candidate_count = 16
max_stream_ranks = 8
cache_size = 64
cache_bytes = 8388608
source_timeout = 12
