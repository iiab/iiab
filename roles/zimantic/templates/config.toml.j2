# Managed by IIAB's zimantic role.
zim_dir = "{{ zimantic_zim_dir }}"
model_dir = "{{ zimantic_model_dir }}"
index_dir = "{{ zimantic_index_dir }}"

port = {{ zimantic_port }}
web_base_path = "{{ zimantic_url_without_slash }}"
kiwix_server = ""

# Tuning is intentionally left to Zimantic's hardware profile: it selects
# mobile, desktop or supercomputer from this host's CPU and RAM. Pinning the
# Raspberry Pi Zero 2 W values here used to cap every IIAB device (including a
# Pi 4/5 or a PC) at two search workers and two concurrent searches, which
# turned ordinary overlapping searches into "server is busy" responses.
#
# Override only what this host needs, in /etc/iiab/local_vars.yml:
#   zimantic_config:
#     max_concurrent_searches: 4
#     search_workers: 4
#     slot_wait_seconds: 15
{% if zimantic_config %}
{% for key, value in zimantic_config | dictsort %}
{% if value is string %}
{{ key }} = {{ value | to_json }}
{% elif value is sameas true %}
{{ key }} = true
{% elif value is sameas false %}
{{ key }} = false
{% else %}
{{ key }} = {{ value }}
{% endif %}
{% endfor %}
{% endif %}
