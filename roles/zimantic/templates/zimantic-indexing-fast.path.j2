# Managed by IIAB's zimantic role.
# Index newly added ZIMs quickly; semantic mode upgrades them overnight.

[Unit]
Description=Index new ZIMs and rescan Zimantic
After=local-fs.target
RequiresMountsFor={{ zimantic_zim_dir }}

[Path]
PathChanged={{ zimantic_zim_dir }}
Unit=zimantic-indexing-fast.service

[Install]
WantedBy=multi-user.target
