[uwsgi]

# IIAB configures the distro-provided Emperor to manage its vassals in
# /etc/uwsgi/apps-enabled. This works with native systemd units on Ubuntu 26.10+
# and SysV-generated units on older Ubuntu, Debian, and Raspberry Pi OS releases.

# IIAB creates both uWSGI app directories in roles/nginx/tasks/main.yml.
emperor = /etc/uwsgi/apps-enabled

# The Emperor and its vassals run as the Apache user (www-data on Debian/Ubuntu).
uid = {{ apache_user }}
gid = {{ apache_user }}

# The master process manager is enabled.
master = true

# The Emperor terminates vassals when it exits.
no-orphans = true

# The Emperor terminates vassals on SIGTERM. The SysV init script also passes
# --die-on-term; the native systemd unit uses KillSignal=SIGQUIT.
die-on-term = true

# Logs include timestamps.
log-date = true