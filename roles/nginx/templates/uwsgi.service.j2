# Native systemd unit for the uWSGI Emperor
# https://uwsgi-docs.readthedocs.io/en/latest/Emperor.html

# On older Ubuntu/Debian, systemd auto-generated a uwsgi.service from the SysV init script 
# provided by the 'uwsgi-initscripts' package. systemd v261+ (Ubuntu 26.10+) removed
# systemd-sysv-generator so that no longer happens -- IIAB now provides this
# unit itself, so Admin Console & Captive Portal keep working:

[Unit]
Description=uWSGI Emperor
After=network.target

[Service]
ExecStart=/usr/bin/uwsgi --emperor /etc/uwsgi/apps-enabled --uid www-data --gid www-data --master --die-on-term
Restart=on-failure

[Install]
WantedBy=multi-user.target
