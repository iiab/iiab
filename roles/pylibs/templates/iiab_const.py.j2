# IIAB constants

iiab_etc_path = '{{ iiab_etc_path }}'
iiab_env_file = '{{ iiab_env_file }}'
iiab_ini_file = '{{ iiab_ini_file }}'
iiab_local_vars_file = '{{ iiab_local_vars_file }}'
iiab_base = '{{ iiab_base }}'
iiab_repo_dir = '{{ iiab_dir }}'
iiab_state_file = '{{ iiab_state_file }}'

kiwix_cat_path = iiab_etc_path + '/kiwix_catalog.json'
zim_path = '{{ iiab_zim_path }}'
# The library file consumed by kiwix-serve.  Honour a local_vars.yml override,
# and otherwise default to library.opds when the Kiwix role defaults are not
# loaded (e.g. a standalone pylibs run).  Its content format (OPDS or classic
# XML) is chosen by iiab-make-kiwix-lib.py from the installed libkiwix version.
# kiwix_library_xml is kept as a legacy alias.  The role default makes the
# legacy variable the fallback, so old local_vars.yml overrides still work.
kiwix_library_path = '{{ kiwix_library_path | default(kiwix_library_xml | default(iiab_zim_path ~ "/library.opds")) }}'
kiwix_library_xml = kiwix_library_path
# Disposable metadata cache; the ZIM directory remains the source of truth.
zim_catalog_db = '{{ zim_catalog_db | default(iiab_zim_path ~ "/catalog.sqlite") }}'
iiab_base_path = '{{ iiab_base }}'
kiwix_serve = iiab_base_path + '/kiwix/bin/kiwix-serve'
kiwix_manage = iiab_base_path + '/kiwix/bin/kiwix-manage'

doc_root = '{{ doc_root }}'
assets_dir = doc_root + '/common/assets/'
lang_codes_path = assets_dir + 'lang_codes.json'

old_zim_map = {"bad.zim": "unparseable name"}
