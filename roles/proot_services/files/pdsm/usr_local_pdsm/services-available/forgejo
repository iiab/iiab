#!/bin/sh
# /usr/local/pdsm/services-available/forgejo
# Simple PDSM service wrapper for Forgejo (IIAB, proot).
# Installed by roles/proot_services (listed in pdsm_installed_services);
# the forgejo role only enables/starts it (tasks/enable-or-disable.yml).

PDSM_COMMON="/usr/local/pdsm/lib/pdsm-common.sh"
[ -r "$PDSM_COMMON" ] && . "$PDSM_COMMON"

SERVICE_NAME="forgejo"

FORGEJO_BIN="/library/forgejo/forgejo"          # stable symlink -> versioned binary
FORGEJO_CONFIG="/etc/forgejo/app.ini"
FORGEJO_WORK_DIR="/library/forgejo"
FORGEJO_LOG="/library/forgejo/log/forgejo.log"
FORGEJO_RUN_DIR="/run/forgejo"
FORGEJO_PIDFILE="$FORGEJO_RUN_DIR/forgejo.pid"

# NOTE (proot test item): Forgejo checks RUN_USER against the running user. Under
# proot the process runs as the login user, so make sure app.ini RUN_USER matches
# (or adjust) during Termux testing. See roles/forgejo/ADR.md D4/D8.

running() {
  [ -s "$FORGEJO_PIDFILE" ] || return 1
  pid="$(cat "$FORGEJO_PIDFILE" 2>/dev/null || echo '')"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

start() {
  if running; then
    echo "[pdsm:$SERVICE_NAME] already running"
    return 0
  fi

  # nginx is the reverse proxy in front of Forgejo
  require_service "nginx" 2>/dev/null || true

  echo "[pdsm:$SERVICE_NAME] starting..."
  mkdir -p "$FORGEJO_RUN_DIR"

  FORGEJO_WORK_DIR="$FORGEJO_WORK_DIR" nohup "$FORGEJO_BIN" web --config "$FORGEJO_CONFIG" \
    >>"$FORGEJO_LOG" 2>&1 &
  echo $! > "$FORGEJO_PIDFILE"

  for i in $(seq 1 "${PDSM_START_TIMEOUT:-15}"); do
    if running; then
      echo "[pdsm:$SERVICE_NAME] started"
      return 0
    fi
    sleep 1
  done

  echo "[pdsm:$SERVICE_NAME] failed to start (check $FORGEJO_LOG)" >&2
  return 1
}

stop() {
  if ! running; then
    echo "[pdsm:$SERVICE_NAME] already stopped"
    return 0
  fi

  echo "[pdsm:$SERVICE_NAME] stopping..."
  pid="$(cat "$FORGEJO_PIDFILE" 2>/dev/null || echo '')"
  [ -n "$pid" ] && kill "$pid" 2>/dev/null || true

  # Fallback: kill any leftover Forgejo web process
  pgrep -f "$FORGEJO_BIN web" >/dev/null 2>&1 && pkill -f "$FORGEJO_BIN web" || true

  for i in $(seq 1 "${PDSM_START_TIMEOUT:-15}"); do
    if ! running; then
      rm -f "$FORGEJO_PIDFILE"
      echo "[pdsm:$SERVICE_NAME] stopped"
      return 0
    fi
    sleep 1
  done

  echo "[pdsm:$SERVICE_NAME] did not fully stop" >&2
  return 1
}

status() {
  if running; then
    echo "[pdsm:$SERVICE_NAME] running"
    return 0
  fi
  echo "[pdsm:$SERVICE_NAME] not running"
  return 3
}

case "$1" in
  start|stop|status)
    "$1"
    ;;
  restart)
    stop
    start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 1
    ;;
esac
