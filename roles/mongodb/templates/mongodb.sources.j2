Types: deb
Architectures: {{ dpkg_arch.stdout }}
{% if dpkg_arch.stdout != "arm64" %} 
{% if is_ubuntu %}
URIs: https://repo.mongodb.org/apt/ubuntu/
Suites: resolute/mongodb-org/{{ mongodb_version }}
Components: multiverse
{% endif %}
{% if is_debian %}
URIs: https://repo.mongodb.org/apt/debian
Suites: trixie/mongodb-org/{{ mongodb_version }}
Components: main
{% endif %}
{% else %}
URIs: https://repo.mongodb.org/apt/ubuntu/
Suites: focal/mongodb-org/{{ mongodb_version }}
Components: multiverse
{% endif %}
Trusted: yes
Signed-By: /etc/apt/keyrings/mongodb.gpg
