# https://git-scm.com/docs/gitignore

build
deprecated
.ansible
*.patches
*.log
*.retry

# Lines below for emacs, which generates even more tmp files since 2022
*~
.#*
\#*#
# ./runrole generates its playbook here; the EXIT trap removes it, but an
# interrupted run should not leave the tree dirty.
runrole-tmp*.yml
# The Admin Console's RUN-ANSIBLE-ROLES hook writes this here.
adm-run-roles-tmp.yml
__pycache__/
