#!/bin/bash

DEFAULT_VARS_FILE=/opt/iiab/iiab/vars/default_vars.yml
LOCAL_VARS_FILE=/etc/iiab/local_vars.yml
IIAB_STATE_FILE=/etc/iiab/iiab_state.yml
IIAB_INI_FILE=/etc/iiab/iiab.ini
#ROLE_NAME=""           # Don't initialize this
#ROLE_VAR=""            # No need to initialize this
#ANSIBLE_LOG_PATH=""    # Don't initialize this
INSTALL=false
REINSTALL=false
FORCE_REINSTALL=false
UPGRADE=false
ASSUME_YES=false
ADD=false
CHECK=false
STATUS=false
CWD=`pwd`
# JSON object for --extra-vars, closed at the bottom of this file
ARGS="--extra-vars {\"skip_role_on_error\":False,"
INVENTORY=ansible_hosts
PLAYBOOK=run-one-role.yml

usage() {
    cat <<'EOF'
Usage: ./runrole [options] <role> [logfile]

Apply a role using /etc/iiab/local_vars.yml. This is safe to repeat: the role
is installed if missing, upgraded if needed, and otherwise only reconfigured.

Options:
  -y, --yes             Do not ask for confirmation
  -a, --add             Run the role even if '*_install: False'
      --apply           Apply settings (the default)
      --upgrade         Upgrade where the role supports it
      --reinstall       Reinstall the program
      --force-reinstall Reinstall, and reset dependencies/caches/settings where supported
      --check           Best-effort Ansible check mode (--check --diff)
      --status          Show installed/desired state without changing anything
  -h, --help            Show this help

Examples:
  ./runrole captiveportal
  ./runrole --upgrade captiveportal
  ./runrole --reinstall captiveportal
  ./runrole --force-reinstall captiveportal
EOF
}

if [ ! -f $PLAYBOOK ]; then
    echo "Exiting: IIAB Playbook not found."
    echo "Please run this in /opt/iiab/iiab (top level of git repo)."
    exit 1
fi

. scripts/runrole-common.sh

# https://stackoverflow.com/questions/192249/how-do-i-parse-command-line-arguments-in-bash/14203146#14203146
while [[ $# -gt 0 ]]; do
    case $1 in    # if-else would do the job, but case statement allows for future changes...
        --apply)
            ;;    # Explicit apply is the default behavior
        --reinstall)
            REINSTALL=true
            ARGS="$ARGS\"reinstall\":True,"    # Needs boolean not string so use JSON list
            ;;
        --force-reinstall)
            REINSTALL=true
            FORCE_REINSTALL=true
            ARGS="$ARGS\"reinstall\":True,\"force_reinstall\":True,"
            ;;
        --upgrade)
            UPGRADE=true
            ARGS="$ARGS\"upgrade\":True,"
            ;;
        -y|--yes)
            ASSUME_YES=true
            ;;
        -a|--add)
            ADD=true
            ;;
        --check)
            CHECK=true
            ;;
        --status)
            STATUS=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $1"
            echo
            usage
            exit 1
            ;;
        *)
            if [ ! -v ROLE_NAME ]; then    # Test whether var is not yet set
                ROLE_NAME="$1"
            elif [ ! -v ANSIBLE_LOG_PATH ]; then
                export ANSIBLE_LOG_PATH="$1"
            else
                echo "Too many arguments (ROLE_NAME and ANSIBLE_LOG_PATH already specified!)"
                exit 1
            fi
            ;;
    esac
    shift
done

if [ ! -v ROLE_NAME ]; then    # Test whether var is STILL not set!
    usage
    exit 1
fi

if $CHECK && $REINSTALL; then
    echo "--check cannot be combined with --reinstall or --force-reinstall."
    echo "Use --status to inspect the role without changing anything."
    exit 1
fi

if [ ! -v ANSIBLE_LOG_PATH ]; then
    export ANSIBLE_LOG_PATH="$CWD/iiab-debug.log"    # Default log file location
fi

ROLE_VAR=$(role_var "$ROLE_NAME")

if $STATUS; then
    status_role "$ROLE_NAME"
    exit 0
fi

# 4 snippets to guide -> bootstrap -> accelerate role debugging on bare OS's:

if ! $CHECK; then
    mkdir -p /etc/iiab    # -p avoids errors, effectively like '|| true'
fi
if [ ! -f /etc/iiab/local_vars.yml ]; then
    echo -e "\n\e[1mEXITING: /opt/iiab/iiab/runrole REQUIRES /etc/iiab/local_vars.yml\e[0m\n" >&2

    echo -e "(1) See http://FAQ.IIAB.IO -> What is local_vars.yml and how do I customize it?" >&2
    echo -e "(2) SMALL/MEDIUM/LARGE samples are included in /opt/iiab/iiab/vars" >&2
    echo -e "(3) NO TIME FOR DETAILS?  RUN INTERNET-IN-A-BOX'S FRIENDLY 1-LINE INSTALLER:\n" >&2

    echo -e '    https://download.iiab.io\n' >&2

    exit 1
fi

CHECK_STATE_FILE=""
cleanup_check_state() {
    if [ -n "$CHECK_STATE_FILE" ]; then
        rm -f "$CHECK_STATE_FILE"
    fi
}
trap cleanup_check_state EXIT

if $CHECK; then
    CHECK_STATE_FILE=$(mktemp /tmp/iiab-state.XXXXXX)
    if [ -f "$IIAB_STATE_FILE" ]; then
        cp "$IIAB_STATE_FILE" "$CHECK_STATE_FILE"
    else
        cat > "$CHECK_STATE_FILE" << EOF
# DO *NOT* MANUALLY EDIT THIS, THANKS!
# IIAB does NOT currently support uninstalling apps/services.

EOF
    fi
    ARGS="$ARGS\"iiab_state_file\":\"$CHECK_STATE_FILE\","
elif [ ! -f "$IIAB_STATE_FILE" ]; then
    # In comparison, ./iiab-network and ./iiab-configure warn operators (IN RED)
    # if run without the existence of /etc/iiab/iiab_state.yml
    echo -e "\n\e[1mCreating... $IIAB_STATE_FILE\e[0m"
    cat > "$IIAB_STATE_FILE" << EOF
# DO *NOT* MANUALLY EDIT THIS, THANKS!
# IIAB does NOT currently support uninstalling apps/services.

EOF
fi

if ! command -v ansible > /dev/null; then
    echo -e "\n\e[1mPlease install Ansible, by running:\n\nsudo /opt/iiab/iiab/scripts/ansible\e[0m\n"
    exit 1
fi

if ! $CHECK; then
    mkdir -p /etc/ansible/facts.d
    cp scripts/local_facts.fact /etc/ansible/facts.d/local_facts.fact
fi

role_install_enabled "$ROLE_NAME" && INSTALL=true

echo
if $REINSTALL; then   # Add '_' so '--reinstall calibre' doesn't zap calibreweb
    if grep -q "^${ROLE_VAR}_" $IIAB_STATE_FILE; then
        if $FORCE_REINSTALL; then
            echo -e "\e[1;31mWARNING: --force-reinstall may delete ${ROLE_NAME}'s data, caches, indexes, and settings where the role supports it.\e[0m"
        fi
        if $FORCE_REINSTALL && ! $ASSUME_YES; then
            echo -n "Type 'yes' to continue: "
            if [ -t 0 ]; then
                read ans < /dev/tty
            else
                echo
                echo "No TTY: refusing --force-reinstall without --yes."
                exit 1
            fi
            echo
            [ "$ans" = "yes" ] || { echo "Cancelled."; exit 1; }
        fi

        echo -e "\e[1mReinstalling ${ROLE_NAME}.\e[0m\n"
        if ! $FORCE_REINSTALL; then
            echo "Use --force-reinstall to also reset dependencies, caches, indexes, and settings where the role supports it."
        fi
        echo -e "\nDeleting these line(s) from $IIAB_STATE_FILE:\n"
        grep "^${ROLE_VAR}_" $IIAB_STATE_FILE; echo
        sed -i "/^${ROLE_VAR}_/d" $IIAB_STATE_FILE
    else
        echo -e "\e[1mERROR: $IIAB_STATE_FILE has no line(s) that begin with '${ROLE_VAR}_'\e[0m\n"
        echo "Nothing to reinstall. Run without --reinstall to install it normally."
        exit 1
    fi
else
    if $UPGRADE; then
        echo -e "\e[1mUpgrading ${ROLE_NAME}.\e[0m\n"
    fi
    if grep -q "^${ROLE_VAR}_" $IIAB_STATE_FILE; then
        if ! $ASSUME_YES && ! $UPGRADE && ! $CHECK; then
            echo -e "\e[1m${ROLE_NAME} is already installed.\e[0m"
            echo "Applying settings from $LOCAL_VARS_FILE (safe to repeat)."
            echo
        fi
    fi
fi

if ! $INSTALL; then
    if ! $ADD; then
        echo -e "\e[1m'${ROLE_VAR}_install: True' MUST BE SET!\e[0m\n"
        echo -e "Set it in: $LOCAL_VARS_FILE\n"
        echo "Or pass --add to run it once despite '${ROLE_VAR}_install: False'."
        exit 1
    fi
    echo "WARNING: --add sets '${ROLE_VAR}_install: True' for this run only."
    ARGS="$ARGS\"${ROLE_VAR}_install\":True,"
fi

ARGS="$ARGS\"role_to_run\":\"$ROLE_NAME\"}"    # $ROLE_NAME works like \"$ROLE_NAME\" if str type validated
CMD="ansible-playbook -i $INVENTORY $PLAYBOOK --connection=local $ARGS"
if $CHECK; then
    echo -e "\e[1;33mWARNING: --check is best-effort; not all roles are check-mode safe.\e[0m\n"
    CMD="$CMD --check --diff"
fi
echo -e "\e[1mRunning:\e[0m\n\n$CMD\n"
ansible -m setup -a 'gather_subset=!hardware,!network' -i $INVENTORY localhost --connection=local | grep python
$CMD

# $ARGS is deliberately unquoted so word splitting hands Ansible the JSON
# object as one argument. It contains no spaces; do not add quotes around it.
