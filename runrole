#!/bin/bash

CWD=$(pwd)
UNINSTALL=false
REINSTALL=false
UPGRADE=false
APPLY=false
ASSUME_YES=false
ADD=false
CHECK_LOCAL_VARS=false
STATUS=false
LIST=false
VERBOSE=false
SKIP_NEVER_INSTALLED=false
CONTINUE_ON_ERROR=false
LOG_FILE=""
ROLES=()
INVENTORY=ansible_hosts
PLAYBOOK=
PLAYBOOK_ROLES=()
UNINSTALL_ROLES=()
APPLY_ROLES=()

if [ ! -f runrole-base.yml ]; then
    echo "Exiting: IIAB Playbook not found."
    echo "Please run this in /opt/iiab/iiab (top level of git repo)."
    exit 1
fi

# shellcheck source=scripts/runrole-common.sh
. scripts/runrole-common.sh

BASE_PLAYBOOK="$IIAB_REPO/runrole-base.yml"

usage() {
    cat <<'EOF'
Usage: ./runrole [options] <role> [role ...]
       ./runrole --list
       ./runrole --status <role> [role ...]
       ./runrole --check-local-vars [role ...]

Apply one or more roles using /etc/iiab/local_vars.yml; repeatable (install if
missing, otherwise reconfigure). See README.md for the lifecycle contract.

Options:
  -y, --yes             Do not ask for confirmation
  -a, --add             Run the roles even if '*_install: False'
  -v, --verbose         Show the Python interpreter and pass -v to Ansible
      --log FILE        Write the Ansible log to FILE (default: ./iiab-debug.log)
      --apply           Apply settings (the default)
      --reinstall       Uninstall each role, then install it again. Roles
                        without uninstall.yml warn and keep their previous
                        install behavior. User settings declared by
                        uninstall.yml are reset
      --upgrade         Upgrade where the role ships upgrade.yml
      --uninstall       Uninstall the programs and their settings, never deleting user data
      --skip-never-installed
                        With --uninstall, skip roles with no installed markers
                        instead of failing before anything is removed
      --continue-on-error
                        Keep going with later roles when one fails, then exit
                        nonzero (runs each role separately; the default stops
                        at the first failure)
      --check-local-vars
                        Validate local_vars.yml and exit, without changing anything
      --status          Show installed/desired state without changing anything
      --list            List roles with their state and capabilities
  -h, --help            Show this help

Examples:
  ./runrole captiveportal
  ./runrole transmission kiwix
  ./runrole --reinstall transmission calibre-web
  ./runrole --upgrade <role>
  ./runrole --uninstall awstats --skip-never-installed
  ./runrole --continue-on-error transmission kiwix
  ./runrole --check-local-vars awstats matomo
  ./runrole --log /tmp/iiab.log captiveportal

No option deletes user data. --status, --list, and --check-local-vars are
read-only. Set '<prefix>_install: True' (or pass -a) before running the install
phases.
EOF
}

# https://stackoverflow.com/questions/192249/how-do-i-parse-command-line-arguments-in-bash/14203146#14203146
while [[ $# -gt 0 ]]; do
    case $1 in
        --apply)
            APPLY=true    # Explicit apply is the default behavior
            ;;
        --reinstall)
            REINSTALL=true
            ;;
        --upgrade)
            UPGRADE=true
            ;;
        --uninstall)
            UNINSTALL=true
            ;;
        --skip-never-installed)
            SKIP_NEVER_INSTALLED=true
            ;;
        --continue-on-error)
            CONTINUE_ON_ERROR=true
            ;;
        -y|--yes)
            ASSUME_YES=true
            ;;
        -a|--add)
            ADD=true
            ;;
        -v|--verbose)
            VERBOSE=true
            ;;
        --log)
            if [ $# -lt 2 ]; then
                echo "ERROR: --log requires a file name."
                exit 1
            fi
            LOG_FILE=$2
            shift
            ;;
        --log=*)
            LOG_FILE=${1#--log=}
            if [ -z "$LOG_FILE" ]; then
                echo "ERROR: --log requires a file name."
                exit 1
            fi
            ;;
        --check-local-vars)
            CHECK_LOCAL_VARS=true
            ;;
        --status)
            STATUS=true
            ;;
        --list)
            LIST=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $1"
            echo
            usage
            exit 1
            ;;
        *)
            ROLES+=("$1")
            ;;
    esac
    shift
done

if $LIST; then
    if [[ ${#ROLES[@]} -gt 0 ]] || $UNINSTALL || $REINSTALL || $UPGRADE || $APPLY || $CHECK_LOCAL_VARS || $STATUS || $ADD || $ASSUME_YES || $VERBOSE || $SKIP_NEVER_INSTALLED || $CONTINUE_ON_ERROR || [ -n "$LOG_FILE" ]; then
        echo "--list is read-only and does not accept roles or other options."
        exit 1
    fi
    list_roles
    exit $?
fi

if [[ ${#ROLES[@]} -eq 0 ]] && ! $CHECK_LOCAL_VARS; then
    usage
    exit 1
fi

for role in "${ROLES[@]}"; do
    if ! [[ $role =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "ERROR: invalid role name: $role"
        exit 1
    fi
    if ! role_exists "$role"; then
        # --status and --check-local-vars also accept prefixes managed by a
        # larger role or stage (squid, hostapd, dnsmasq).
        if ! $STATUS; then
            if ! $CHECK_LOCAL_VARS || ! is_checklist_prefix "$role"; then
                echo "ERROR: unknown role: $role"
                echo "Run './runrole --list' to see the available roles."
                exit 1
            fi
        fi
    fi
done

validate_options

if [ -n "$LOG_FILE" ]; then
    export ANSIBLE_LOG_PATH="$LOG_FILE"
elif [ -z "${ANSIBLE_LOG_PATH:-}" ]; then
    export ANSIBLE_LOG_PATH="$CWD/iiab-debug.log"    # Default log file location
fi

if $STATUS; then
    status_failures=0
    for role in "${ROLES[@]}"; do
        status_role "$role" || status_failures=1
    done
    exit "$status_failures"
fi

unsupported=false
for role in "${ROLES[@]}"; do
    if $REINSTALL && ! role_require_capability "$role" "--reinstall" reinstall \
        "This role opts out because reinstalling it requires manual cleanup (see roles/${role}/meta/runrole.yml)."; then
        unsupported=true
    fi
    # --skip-never-installed removes only roles that are installed. A role
    # without a marker must not fail the capability check that protects the
    # roles it skips.
    if $UNINSTALL && $SKIP_NEVER_INSTALLED && ! state_has_prefix "$(role_var "$role")"; then
        :
    elif $UNINSTALL && ! role_require_capability "$role" "--uninstall" uninstall; then
        unsupported=true
    fi
    if $UPGRADE && ! role_require_capability "$role" "--upgrade" upgrade \
        "This role does not ship tasks/upgrade.yml, so it has no application-native upgrade path."; then
        unsupported=true
    fi
done
if $unsupported; then
    exit 1
fi

if ! $CHECK_LOCAL_VARS; then
    mkdir -p "$(dirname "$LOCAL_VARS_FILE")"    # -p avoids errors, effectively like '|| true'
fi
if [ ! -f "$LOCAL_VARS_FILE" ]; then
    echo -e "\n\e[1mEXITING: /opt/iiab/iiab/runrole REQUIRES $LOCAL_VARS_FILE\e[0m\n" >&2

    echo -e "(1) See http://FAQ.IIAB.IO -> What is local_vars.yml and how do I customize it?" >&2
    echo -e "(2) SMALL/MEDIUM/LARGE samples are included in /opt/iiab/iiab/vars" >&2
    echo -e "(3) NO TIME FOR DETAILS?  RUN INTERNET-IN-A-BOX'S FRIENDLY 1-LINE INSTALLER:\n" >&2

    echo -e '    https://download.iiab.io\n' >&2

    exit 1
fi

if ! command -v ansible > /dev/null; then
    echo -e "\n\e[1mPlease install Ansible, by running:\n\nsudo /opt/iiab/iiab/scripts/ansible\e[0m\n"
    exit 1
fi

if $CHECK_LOCAL_VARS; then
    PLAYBOOK=check-local-vars.yml
    CHECK_LOCAL_VARS_ROLES=""
    for role in "${ROLES[@]}"; do
        if role_exists "$role" && [ -z "$(role_install_var "$role")" ]; then
            echo "NOTE: ${role} is an always-on helper role; it has no install/enabled vars to validate."
            continue
        fi
        prefix=$(checklist_install_var "$role")
        if ! is_checklist_prefix "$prefix"; then
            echo "ERROR: no validation checklist entry for '$role' (prefix '$prefix')." >&2
            echo "Add '${prefix}' to vars_checklist_all in roles/0-init/tasks/validate_vars.yml." >&2
            exit 1
        fi
        CHECK_LOCAL_VARS_ROLES="${CHECK_LOCAL_VARS_ROLES}\"${prefix}\","
    done
    if [[ ${#ROLES[@]} -gt 0 ]]; then
        CHECK_LOCAL_VARS_EXTRA="{\"validate_roles\":[${CHECK_LOCAL_VARS_ROLES%,}]}"
    else
        CHECK_LOCAL_VARS_EXTRA='{}'
    fi
    run_playbook "$CHECK_LOCAL_VARS_EXTRA"
    exit $?
fi

ensure_state_file
trap cleanup_temp_files EXIT

# The generated playbook keeps the repository's relative vars_files working.
# The EXIT trap removes it, and .gitignore covers an interrupted run.
write_playbook() {
    [ -n "$PLAYBOOK" ] && rm -f "$PLAYBOOK"
    PLAYBOOK=$(mktemp "$IIAB_REPO/runrole-tmp.XXXXXX.yml") || {
        echo -e "\e[1mERROR: could not create a temporary playbook in $IIAB_REPO.\e[0m" >&2
        exit 1
    }
    TEMP_PLAYBOOK=$PLAYBOOK
    cp "$BASE_PLAYBOOK" "$PLAYBOOK" || {
        echo -e "\e[1mERROR: could not read $BASE_PLAYBOOK.\e[0m" >&2
        exit 1
    }
    for role in "$@"; do
        printf '    - { role: %s }\n' "$role" >> "$PLAYBOOK"
    done
}

APPLY_ROLES=("${ROLES[@]}")
MISSING_ROLES=()

# Apply/reinstall phases act on roles the configuration says should be
# installed. Refuse before anything runs -- including before a legacy role's
# markers are forgotten -- instead of letting the role's tasks install
# something that local_vars.yml disables.
if ! $UNINSTALL; then
    missing_install=false
    for role in "${APPLY_ROLES[@]}"; do
        if ! role_install_enabled "$role"; then
            var=$(role_install_var "$role")
            if $ADD; then
                echo "WARNING: --add sets '${var}_install: True' for $role, for this run only."
            else
                echo -e "\e[1mERROR: '${var}_install: True' MUST BE SET for $role!\e[0m" >&2
                echo "Set it in: $LOCAL_VARS_FILE, or pass --add to run it once." >&2
                if state_has_prefix "$(role_var "$role")" && role_supports "$role" uninstall; then
                    echo "Or remove the existing installation with: sudo ./runrole --uninstall $role" >&2
                fi
                missing_install=true
            fi
        fi
    done
    if $missing_install; then
        exit 1
    fi
fi

if $UNINSTALL; then
    UNINSTALL_ROLES=()
    for role in "${ROLES[@]}"; do
        var=$(role_var "$role")
        if state_has_prefix "$var"; then
            UNINSTALL_ROLES+=("$role")
        else
            MISSING_ROLES+=("$role")
        fi
    done

    if [[ ${#MISSING_ROLES[@]} -gt 0 ]]; then
        if $SKIP_NEVER_INSTALLED; then
            for role in "${MISSING_ROLES[@]}"; do
                echo "$role has no installed markers; skipping."
            done
        else
            echo -e "\e[1mERROR: no installed markers in $IIAB_STATE_FILE:\e[0m" >&2
            printf '  %s\n' "${MISSING_ROLES[@]}" >&2
            echo "Nothing was uninstalled. Pass --skip-never-installed to uninstall the installed roles only." >&2
            exit 1
        fi
    fi
    if [[ ${#UNINSTALL_ROLES[@]} -eq 0 ]]; then
        echo -e "\e[1mERROR: none of the listed roles have installed markers in $IIAB_STATE_FILE\e[0m"
        echo "Nothing to uninstall."
        exit 1
    fi

    echo -e "\e[1;31mWARNING: --uninstall removes the listed roles and their settings, but never deletes their user data.\e[0m"
    confirm_destructive || { echo "Cancelled."; exit 1; }

    for role in "${UNINSTALL_ROLES[@]}"; do
        echo "Uninstalling $role. These markers stay until it finishes:"
        state_show_prefix "$(role_var "$role")" | sed 's/^/  /'
    done
    echo
    APPLY_ROLES=("${UNINSTALL_ROLES[@]}")
elif $REINSTALL; then
    for role in "${ROLES[@]}"; do
        var=$(role_var "$role")
        if state_has_prefix "$var"; then
            if ! role_has_phase "$role" uninstall; then
                echo -e "\e[1;33mWARNING: ${role} has no uninstall.yml; --reinstall behavior is ambiguous.\e[0m" >&2
                echo "It will rerun install.yml." >&2
            fi
            if role_uses_runner "$role"; then
                if role_has_phase "$role" uninstall; then
                    echo "Reinstalling $role (uninstall, then install). Its markers will be recreated when the install succeeds."
                    echo "User settings declared by its uninstall.yml will be reset."
                else
                    echo "Reinstalling $role by rerunning install.yml. Its markers stay in place:"
                fi
                state_show_prefix "$var" | sed 's/^/  /'
            else
                echo "Reinstalling $role. Legacy role: removing its markers before the reinstall:"
                state_show_prefix "$var" | sed 's/^/  /'
                state_cmd forget "$var" >/dev/null || {
                    echo -e "\e[1mERROR: could not remove ${var}_* markers from $IIAB_STATE_FILE.\e[0m" >&2
                    exit 2
                }
            fi
        else
            echo "$role is not installed; it will be installed normally."
        fi
    done
    echo
elif $UPGRADE; then
    missing_upgrade=false
    for role in "${ROLES[@]}"; do
        var=$(role_var "$role")
        if state_has_prefix "$var"; then
            echo "Upgrading $role. Its markers stay until the upgrade finishes:"
            state_show_prefix "$var" | sed 's/^/  /'
        else
            echo -e "\e[1mERROR: ${role} has no installed markers in $IIAB_STATE_FILE; --upgrade does not install.\e[0m" >&2
            echo "Run without --upgrade to install it first." >&2
            missing_upgrade=true
        fi
    done
    if $missing_upgrade; then
        exit 1
    fi
    echo
else
    if ! $ASSUME_YES; then
        installed=false
        for role in "${ROLES[@]}"; do
            if state_has_prefix "$(role_var "$role")"; then
                installed=true
                break
            fi
        done
        if $installed; then
            echo "Applying settings to already-installed role(s) from $LOCAL_VARS_FILE."
            echo "This is safe to repeat."
            echo
        fi
    fi
fi

extra_vars() {
    local phase=$1
    local json='{"skip_role_on_error":false'
    local validate_roles=""
    local install_var
    local role

    if [ "$phase" = uninstall ]; then
        json="$json,\"uninstall\":true"
    else
        if $REINSTALL; then
            json="$json,\"iiab_role_reinstall\":true"
        fi
        if $UPGRADE; then
            json="$json,\"upgrade\":true"
        fi
        if $ADD; then
            for role in "${PLAYBOOK_ROLES[@]}"; do
                install_var=$(role_install_var "$role")
                if [ -n "$install_var" ]; then
                    json="$json,\"${install_var}_install\":true"
                fi
            done
        fi
    fi
    for role in "${PLAYBOOK_ROLES[@]}"; do
        install_var=$(role_install_var "$role")
        if [ -n "$install_var" ]; then
            if is_checklist_prefix "$install_var"; then
                validate_roles="${validate_roles}\"${install_var}\","
            else
                echo "WARNING: no validation checklist entry for ${role} (${install_var}); skipping install/enabled validation." >&2
            fi
        fi
    done
    printf '%s,"validate_roles":[%s]}' "$json" "${validate_roles%,}"
}

# Run one role in its own playbook. --continue-on-error uses this so a failure
# in one role does not stop the roles after it.
run_one_phase() {
    local phase=$1
    local role=$2
    PLAYBOOK_ROLES=("$role")
    write_playbook "$role"
    run_playbook "$(extra_vars "$phase")"
}

if $VERBOSE; then
    echo -e "\e[1mDetected Python interpreter:\e[0m"
    ansible -m setup -a 'gather_subset=!hardware,!network' -i "$INVENTORY" localhost --connection=local | grep python
    echo
fi

install_local_facts

if $CONTINUE_ON_ERROR; then
    STATUS_CODE=0
    CONTINUE_FAILED=()

    if $UNINSTALL; then
        for role in "${UNINSTALL_ROLES[@]}"; do
            run_one_phase uninstall "$role"
            role_status=$?
            if [ "$role_status" -ne 0 ]; then
                STATUS_CODE=1
                CONTINUE_FAILED+=("$role")
            elif ! verify_uninstall_markers "$role"; then
                STATUS_CODE=1
                CONTINUE_FAILED+=("$role")
            fi
        done
    else
        for role in "${APPLY_ROLES[@]}"; do
            run_one_phase apply "$role"
            role_status=$?
            if [ "$role_status" -ne 0 ]; then
                STATUS_CODE=1
                CONTINUE_FAILED+=("$role")
            fi
        done
    fi

    if [ "$STATUS_CODE" -ne 0 ]; then
        echo -e "\e[1mERROR: these roles failed:\e[0m" >&2
        printf '  %s\n' "${CONTINUE_FAILED[@]}" >&2
        echo "The other listed roles were still processed." >&2
    fi

    if $UNINSTALL; then
        PLAYBOOK_ROLES=("${UNINSTALL_ROLES[@]}")
    else
        PLAYBOOK_ROLES=("${APPLY_ROLES[@]}")
    fi
elif $UNINSTALL; then
    PLAYBOOK_ROLES=("${UNINSTALL_ROLES[@]}")
    write_playbook "${PLAYBOOK_ROLES[@]}"
    run_playbook "$(extra_vars uninstall)"
    STATUS_CODE=$?
else
    PLAYBOOK_ROLES=("${APPLY_ROLES[@]}")
    write_playbook "${PLAYBOOK_ROLES[@]}"
    run_playbook "$(extra_vars apply)"
    STATUS_CODE=$?
fi

if [ "$STATUS_CODE" -ne 0 ]; then
    exit "$STATUS_CODE"
fi

if $UNINSTALL; then
    for role in "${PLAYBOOK_ROLES[@]}"; do
        verify_uninstall_markers "$role" || exit 1
        var=$(role_var "$role")
        echo "Removed ${var}_* markers from $IIAB_STATE_FILE."
    done
    echo "To keep them uninstalled, set these in $LOCAL_VARS_FILE:"
    for role in "${PLAYBOOK_ROLES[@]}"; do
        install_var=$(role_install_var "$role")
        if [ -n "$install_var" ]; then
            echo "  ${install_var}_install: False"
            echo "  ${install_var}_enabled: False"
        fi
    done
    echo
fi

# --add forces '<prefix>_install: True' for this run only.  If it installed
# something, local_vars.yml still says False, which the next full run will
# reject.  Say so now, with the two ways out.
if $ADD && ! $UNINSTALL; then
    for role in "${PLAYBOOK_ROLES[@]}"; do
        var=$(role_var "$role")
        install_var=$(role_install_var "$role")
        if [ -n "$install_var" ] && state_has_prefix "$var" && ! role_install_enabled "$role"; then
            echo -e "\e[1;33mNOTE: --add did not change $LOCAL_VARS_FILE.\e[0m"
            echo "'${install_var}_install' is still False there, but ${role} is installed."
            echo "Set '${install_var}_install: True' to keep it, or remove it with:"
            if role_supports "$role" uninstall; then
                echo "  sudo ./runrole --uninstall ${role}"
            else
                echo "  sudo ./scripts/iiab-state forget ${var}"
                echo "  (only after the program and its settings are gone)"
            fi
            echo
        fi
    done
fi
