#!/bin/bash

CWD=$(pwd)
#ROLE_NAME=""           # Don't initialize this
#ROLE_VAR=""            # No need to initialize this
#ANSIBLE_LOG_PATH=""    # Don't initialize this
INSTALL=false
UNINSTALL=false
REINSTALL=false
CLEAN_INSTALL=false
ASSUME_YES=false
ADD=false
CHECK=false
CHECK_LOCAL_VARS=false
STATUS=false
LIST=false
VERBOSE=false
CLEAN_INSTALL_RECOVERY=false
INVENTORY=ansible_hosts
PLAYBOOK=run-one-role.yml

usage() {
    cat <<'EOF'
Usage: ./runrole [options] <role> [logfile]
       ./runrole --list
       ./runrole --status <role>
       ./runrole --check-local-vars [role]

Apply a role using /etc/iiab/local_vars.yml. Runs are repeatable: the role is
installed if missing and otherwise reconfigured.

Options:
  -y, --yes             Do not ask for confirmation
  -a, --add             Run the role even if '*_install: False'
  -v, --verbose         Show the detected Python interpreter and pass -v to Ansible
      --apply           Apply settings (the default)
      --reinstall       Rebuild the program (roles may opt out in meta/runrole.yml)*
      --clean-install   Uninstall the role, then install it again. Requires the
                        role to support --uninstall; never deletes user data
      --uninstall       Uninstall the program, never deleting user data (roles
                        that implement 'uninstall')
      --check           Best-effort Ansible check mode (--check --diff)
      --check-local-vars
                        Validate /etc/iiab/local_vars.yml and exit, without
                        running or changing anything. Checks the full checklist,
                        or only the listed role(s)
      --status          Show installed/desired state without changing anything
      --list            List roles with their installed state and capabilities
  -h, --help            Show this help

Examples:
  ./runrole captiveportal
  ./runrole --reinstall captiveportal
  ./runrole --clean-install awstats
  ./runrole --uninstall awstats
  ./runrole --status captiveportal
  ./runrole --list
  ./runrole --check-local-vars
  ./runrole --check-local-vars captiveportal

No runrole option deletes user data. Roles declare their user data, and the
lifecycle test enforces it for every option. --reinstall is a rebuild, not a
reset: whether settings and program data survive depends on the role. To remove
user data, do it manually.

--reinstall, --clean-install and --uninstall act on a role that is already
installed, and the install phases also require '<prefix>_install: True' (pass -a
to override it for one run). --clean-install is literally --uninstall followed
by a normal apply, so a role supports it exactly when it supports --uninstall.
--status and --list are read-only and cannot be combined with other options.
--check-local-vars is read-only too: it validates the configuration and exits.

* --reinstall reruns the role's install/update path. Some roles keep settings
  and program data, others rewrite or remove them; use --clean-install when you
  want a known reset. User data is never deleted: roles declare it in
  '<role>_user_data' and the lifecycle test enforces it. Legacy roles have
  their state markers removed first, as before; converted roles keep them
  until the rebuild succeeds.

If --uninstall keeps failing, fix the reported error and retry. The role's
markers are removed only after cleanup succeeds. If you already removed the
program another way, clear its markers with the role's state-file prefix
(calibre-web uses calibreweb):
  sudo ./scripts/iiab-state forget <prefix>
This makes IIAB treat the role as uninstalled, so do it only after the program
and its settings are gone.
EOF
}

if [ ! -f "$PLAYBOOK" ]; then
    echo "Exiting: IIAB Playbook not found."
    echo "Please run this in /opt/iiab/iiab (top level of git repo)."
    exit 1
fi

# shellcheck source=scripts/runrole-common.sh
. scripts/runrole-common.sh

# https://stackoverflow.com/questions/192249/how-do-i-parse-command-line-arguments-in-bash/14203146#14203146
while [[ $# -gt 0 ]]; do
    case $1 in
        --apply)
            ;;    # Explicit apply is the default behavior
        --reinstall)
            REINSTALL=true
            ;;
        --clean-install)
            CLEAN_INSTALL=true
            ;;
        --uninstall)
            UNINSTALL=true
            ;;
        -y|--yes)
            ASSUME_YES=true
            ;;
        -a|--add)
            ADD=true
            ;;
        -v|--verbose)
            VERBOSE=true
            ;;
        --check)
            CHECK=true
            ;;
        --check-local-vars)
            CHECK_LOCAL_VARS=true
            ;;
        --status)
            STATUS=true
            ;;
        --list)
            LIST=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $1"
            echo
            usage
            exit 1
            ;;
        *)
            if [ ! -v ROLE_NAME ]; then    # Test whether var is not yet set
                ROLE_NAME="$1"
            elif [ ! -v ANSIBLE_LOG_PATH ]; then
                export ANSIBLE_LOG_PATH="$1"
            else
                echo "Too many arguments (ROLE_NAME and ANSIBLE_LOG_PATH already specified!)"
                exit 1
            fi
            ;;
    esac
    shift
done

if $LIST; then
    if [ -v ROLE_NAME ] || $UNINSTALL || $REINSTALL || $CLEAN_INSTALL || $CHECK || $CHECK_LOCAL_VARS || $STATUS || $ADD || $ASSUME_YES || $VERBOSE; then
        echo "--list is read-only and does not accept a role or other options."
        exit 1
    fi
    list_roles
    exit $?
fi

if [ ! -v ROLE_NAME ] && ! $CHECK_LOCAL_VARS; then    # Test whether var is STILL not set!
    usage
    exit 1
fi

if [ -v ROLE_NAME ]; then
    if ! [[ $ROLE_NAME =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "ERROR: invalid role name: $ROLE_NAME"
        exit 1
    fi

    if ! role_exists "$ROLE_NAME"; then
        # --status also accepts prefixes managed by a larger role or stage
        # (squid, hostapd, dnsmasq, admin_console), so validation errors can
        # point users at './runrole --status <prefix>'.
        if ! $STATUS; then
            echo "ERROR: unknown role: $ROLE_NAME"
            echo "Run './runrole --list' to see the available roles."
            exit 1
        fi
    fi
fi

if $CHECK_LOCAL_VARS && ($UNINSTALL || $REINSTALL || $CLEAN_INSTALL || $ADD || $CHECK || $STATUS || $ASSUME_YES || $VERBOSE); then
    echo "--check-local-vars is read-only and cannot be combined with other options."
    exit 1
fi

if $UNINSTALL && ($REINSTALL || $CLEAN_INSTALL || $ADD); then
    echo "--uninstall cannot be combined with --add, --reinstall, or --clean-install."
    exit 1
fi

if $CLEAN_INSTALL && ($REINSTALL || $ADD); then
    echo "--clean-install cannot be combined with --add or --reinstall."
    echo "It already uninstalls the role and installs it again."
    exit 1
fi

if $CHECK && $UNINSTALL; then
    echo "--check cannot be combined with --uninstall."
    echo "Use --status to inspect the role without changing anything."
    exit 1
fi

if $CHECK && ($REINSTALL || $CLEAN_INSTALL); then
    echo "--check cannot be combined with --reinstall or --clean-install."
    echo "Use --status to inspect the role without changing anything."
    exit 1
fi

if $STATUS && ($UNINSTALL || $REINSTALL || $CLEAN_INSTALL || $ADD || $CHECK || $ASSUME_YES || $VERBOSE); then
    echo "--status is read-only and cannot be combined with other options."
    exit 1
fi

if [ ! -v ANSIBLE_LOG_PATH ]; then
    export ANSIBLE_LOG_PATH="$CWD/iiab-debug.log"    # Default log file location
fi

ROLE_VAR=""
ROLE_INSTALL_VAR=""
if [ -v ROLE_NAME ] && ! $STATUS; then
    ROLE_VAR=$(role_var "$ROLE_NAME")
    ROLE_INSTALL_VAR=$(role_install_var "$ROLE_NAME")
fi

if $STATUS; then
    status_role "$ROLE_NAME"
    exit $?
fi

if $REINSTALL; then
    role_require_capability "$ROLE_NAME" "--reinstall" reinstall \
        "This role opts out because rebuilding it requires manual cleanup (see roles/${ROLE_NAME}/meta/runrole.yml)." || exit 1
fi
if $UNINSTALL; then
    role_require_capability "$ROLE_NAME" "--uninstall" uninstall || exit 1
fi
if $CLEAN_INSTALL; then
    role_require_capability "$ROLE_NAME" "--clean-install" uninstall \
        "--clean-install uninstalls the role and then installs it again, so it needs the same implementation as --uninstall." || exit 1
fi

if ! $CHECK && ! $CHECK_LOCAL_VARS; then
    mkdir -p "$(dirname "$LOCAL_VARS_FILE")"    # -p avoids errors, effectively like '|| true'
fi
if [ ! -f "$LOCAL_VARS_FILE" ]; then
    echo -e "\n\e[1mEXITING: /opt/iiab/iiab/runrole REQUIRES $LOCAL_VARS_FILE\e[0m\n" >&2

    echo -e "(1) See http://FAQ.IIAB.IO -> What is local_vars.yml and how do I customize it?" >&2
    echo -e "(2) SMALL/MEDIUM/LARGE samples are included in /opt/iiab/iiab/vars" >&2
    echo -e "(3) NO TIME FOR DETAILS?  RUN INTERNET-IN-A-BOX'S FRIENDLY 1-LINE INSTALLER:\n" >&2

    echo -e '    https://download.iiab.io\n' >&2

    exit 1
fi

ensure_state_file
stage_check_state
trap cleanup_temp_files EXIT

if ! command -v ansible > /dev/null; then
    echo -e "\n\e[1mPlease install Ansible, by running:\n\nsudo /opt/iiab/iiab/scripts/ansible\e[0m\n"
    exit 1
fi

install_local_facts

if $CHECK_LOCAL_VARS; then
    PLAYBOOK=check-local-vars.yml
    if [ -v ROLE_NAME ]; then
        if [ -z "$ROLE_INSTALL_VAR" ]; then
            echo "NOTE: ${ROLE_NAME} is an always-on helper role; it has no install/enabled vars to validate."
        fi
        CHECK_LOCAL_VARS_EXTRA="{\"validate_roles\":[\"${ROLE_INSTALL_VAR:-$ROLE_VAR}\"]}"
    else
        CHECK_LOCAL_VARS_EXTRA='{}'
    fi
    run_playbook "$CHECK_LOCAL_VARS_EXTRA"
    exit $?
fi

role_install_enabled "$ROLE_NAME" && INSTALL=true

# Check this before running: a refused reinstall/clean-install must not start.
if ! $UNINSTALL && ! $INSTALL; then
    if ! $ADD; then
        echo -e "\e[1m'${ROLE_INSTALL_VAR}_install: True' MUST BE SET!\e[0m\n"
        echo -e "Set it in: $LOCAL_VARS_FILE\n"
        echo "Or pass --add to run it once despite '${ROLE_INSTALL_VAR}_install: False'."
        if state_has_prefix "$ROLE_VAR" && role_supports "$ROLE_NAME" uninstall; then
            echo "Or remove the existing installation with: sudo ./runrole --uninstall ${ROLE_NAME}"
        fi
        exit 1
    fi
    echo "WARNING: --add sets '${ROLE_INSTALL_VAR}_install: True' for this run only."
fi

echo
if $UNINSTALL || $CLEAN_INSTALL; then
    if state_has_prefix "$ROLE_VAR"; then
        if $CLEAN_INSTALL; then
            echo -e "\e[1;31mWARNING: --clean-install uninstalls ${ROLE_NAME} and its settings, then installs it again. User data is never deleted.\e[0m"
        else
            echo -e "\e[1;31mWARNING: --uninstall removes ${ROLE_NAME} and its settings, but never deletes its user data.\e[0m"
        fi
        confirm_destructive || { echo "Cancelled."; exit 1; }

        if $CLEAN_INSTALL; then
            echo -e "\e[1mClean-installing ${ROLE_NAME}.\e[0m\n"
        else
            echo -e "\e[1mUninstalling ${ROLE_NAME}.\e[0m\n"
        fi
        echo -e "These marker(s) will be removed only after a successful uninstall:\n"
        state_show_prefix "$ROLE_VAR"; echo
    elif $CLEAN_INSTALL; then
        # A previous clean-install may already have uninstalled the role
        # before its apply phase failed.  Continue with a normal apply instead
        # of refusing to finish the job.
        CLEAN_INSTALL_RECOVERY=true
        echo -e "\e[1m${ROLE_NAME} is not installed; nothing to uninstall. Installing it now.\e[0m\n"
    else
        echo -e "\e[1mERROR: $IIAB_STATE_FILE has no marker that begins with '${ROLE_VAR}_'\e[0m\n"
        echo "Nothing to uninstall."
        exit 1
    fi
elif $REINSTALL; then
    if state_has_prefix "$ROLE_VAR"; then
        echo -e "\e[1mReinstalling ${ROLE_NAME}.\e[0m\n"
        if role_uses_runner "$ROLE_NAME"; then
            echo -e "\nThe installed marker(s) stay in place until the reinstall succeeds:\n"
            state_show_prefix "$ROLE_VAR"; echo
        else
            echo -e "\nThis role does not use the shared lifecycle runner, so these marker(s) are removed before the rebuild (the previous --reinstall behavior):\n"
            state_show_prefix "$ROLE_VAR"; echo
            state_cmd forget "$ROLE_VAR" >/dev/null || {
                echo -e "\e[1mERROR: could not remove ${ROLE_VAR}_* markers from $IIAB_STATE_FILE.\e[0m" >&2
                exit 2
            }
        fi
    else
        echo -e "\e[1mERROR: $IIAB_STATE_FILE has no marker that begins with '${ROLE_VAR}_'\e[0m\n"
        echo "Nothing to reinstall. Run without --reinstall to install it normally."
        exit 1
    fi
else
    if state_has_prefix "$ROLE_VAR" && ! $ASSUME_YES && ! $CHECK; then
        echo -e "\e[1m${ROLE_NAME} is already installed.\e[0m"
        echo "Applying settings from $LOCAL_VARS_FILE (safe to repeat)."
        echo
    fi
fi

# Build the JSON object for --extra-vars. "uninstall" is the first phase of
# --clean-install; everything else is one normal apply.
extra_vars() {
    local phase=$1
    local json='{"skip_role_on_error":false'
    if [ "$phase" = uninstall ]; then
        json="$json,\"uninstall\":true"
    else
        if $REINSTALL; then
            json="$json,\"reinstall\":true"
        fi
        if $ADD && [ -n "$ROLE_INSTALL_VAR" ]; then
            json="$json,\"${ROLE_INSTALL_VAR}_install\":true"
        fi
        if $CHECK; then
            json="$json,\"iiab_state_file\":\"${CHECK_STATE_FILE}\""
        fi
    fi
    json="$json,\"validate_roles\":[\"${ROLE_INSTALL_VAR:-$ROLE_VAR}\"]"
    json="$json,\"role_to_run\":\"${ROLE_NAME}\"}"
    printf '%s' "$json"
}

if $VERBOSE; then
    echo -e "\e[1mDetected Python interpreter:\e[0m"
    ansible -m setup -a 'gather_subset=!hardware,!network' -i "$INVENTORY" localhost --connection=local | grep python
    echo
fi

if $CHECK; then
    echo -e "\e[1;33mWARNING: --check is best-effort; not all roles are check-mode safe.\e[0m\n"
fi

if $CLEAN_INSTALL && ! $CLEAN_INSTALL_RECOVERY; then
    run_playbook "$(extra_vars uninstall)"
    STATUS_CODE=$?
    if [ "$STATUS_CODE" -ne 0 ]; then
        exit "$STATUS_CODE"
    fi
    verify_uninstall_markers "$ROLE_NAME" || exit 1
    echo -e "\n\e[1m${ROLE_NAME} removed. Installing it again.\e[0m\n"
    run_playbook "$(extra_vars apply)"
    STATUS_CODE=$?
elif $CLEAN_INSTALL_RECOVERY; then
    run_playbook "$(extra_vars apply)"
    STATUS_CODE=$?
elif $UNINSTALL; then
    run_playbook "$(extra_vars uninstall)"
    STATUS_CODE=$?
else
    run_playbook "$(extra_vars apply)"
    STATUS_CODE=$?
fi

if [ "$STATUS_CODE" -ne 0 ]; then
    exit "$STATUS_CODE"
fi

if $UNINSTALL; then
    verify_uninstall_markers "$ROLE_NAME" || exit 1
    echo -e "Removed ${ROLE_VAR}_* markers from $IIAB_STATE_FILE."
    echo -e "Set '${ROLE_INSTALL_VAR:-$ROLE_VAR}_install: False' in $LOCAL_VARS_FILE to keep it uninstalled.\n"
elif $CLEAN_INSTALL; then
    if ! state_has_prefix "$ROLE_VAR"; then
        echo -e "\e[1mERROR: ${ROLE_NAME} finished without writing its installed marker.\e[0m" >&2
        echo "The install phase did not report success; check the log above." >&2
        exit 1
    fi
    if $CLEAN_INSTALL_RECOVERY; then
        echo -e "Finished installing ${ROLE_NAME}.\n"
    else
        echo -e "Clean-installed ${ROLE_NAME}.\n"
    fi
fi

# --add forces '<prefix>_install: True' for this run only.  If it installed
# something, local_vars.yml still says False, which the next full run will
# reject.  Say so now, with the two ways out.
if $ADD && ! $UNINSTALL && ! $CLEAN_INSTALL && ! $CHECK; then
    if [ -n "$ROLE_INSTALL_VAR" ] && state_has_prefix "$ROLE_VAR" && ! role_install_enabled "$ROLE_NAME"; then
        echo -e "\e[1;33mNOTE: --add did not change $LOCAL_VARS_FILE.\e[0m"
        echo "'${ROLE_INSTALL_VAR}_install' is still False there, but ${ROLE_NAME} is installed."
        echo "Set '${ROLE_INSTALL_VAR}_install: True' to keep it, or remove it with:"
        if role_supports "$ROLE_NAME" uninstall; then
            echo "  sudo ./runrole --uninstall ${ROLE_NAME}"
        else
            echo "  sudo ./scripts/iiab-state forget ${ROLE_VAR}"
            echo "  (only after the program and its settings are gone)"
        fi
        echo
    fi
fi
