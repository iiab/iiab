#!/bin/bash -e
if [[ $(id -un) != "root" ]]; then
    echo -e "\nPlease run: sudo iiab-freshen\n"
    exit 1
else
    echo -e "\nPlease ensure internet is available before proceeding\n"
    echo -e "\nProceed? [Y/n] MUST BE Y TO CONTINUE"
    read -n 1 -r ans < /dev/tty
    echo
    if [[ $ans != "Y" ]]; then
        echo -e "Exiting \n"
        exit 1
    fi
fi

cd /opt/iiab/iiab
git checkout master
git pull --ff

export DEBIAN_FRONTEND=noninteractive

apt update
apt upgrade -y
apt autoremove -y

# just rebuild ansible
rm -rf /usr/local/ansible
scripts/ansible

if [ -d /opt/iiab/iiab-admin-console ] && [ -f /etc/iiab/install-flags/iiab-admin-console-complete ]; then
    cd /opt/iiab/iiab-admin-console
    git checkout master
    if ! git pull -ff | grep 'Already up to date'; then
        echo -e "\nUpdating iiab-admin-console\n"
        ./install
    fi
fi

touch /etc/iiab/install-flags/iiab-refreshed
echo -e "\nIIAB install updated\n"
echo -e "\nREBOOTING NOW\n"
reboot
exit 0
